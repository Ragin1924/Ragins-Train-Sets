    return switch_Downer_Waratah_Liv1_MotorStack_r;    //Rear panto
}

switch(FEAT_TRAINS, SELF, sw_Downer_Waratah_Liv1_panto_flipcheck, vehicle_is_flipped){
    0 : sw_Downer_Waratah_Liv1_panto_direction;        //Not flipped, give Panto
    return spriteset_Downer_Waratah_Liv1_lead;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, sw_Downer_Waratah_Liv1_frontcheck, position_in_vehid_chain){
    0: sw_Downer_Waratah_Liv1_panto_direction; //We need a pantograph, guaranteed
    return sw_Downer_Waratah_Liv1_panto_flipcheck; //More Checks
}

const Downer_Waratah_ID_Liv1 = (Downer_Waratah_ID + Liv1_ID);

item(FEAT_TRAINS, Item_Downer_Waratah_Liv1, Downer_Waratah_ID_Liv1) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_DOWNER_WARATAH);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Downer_Waratah_IntroDate;		
		length:                         Downer_Waratah_Length;
		
		loading_speed:					DD_Suburban_LoadingSpeed;
		speed:							Downer_Waratah_Speed km/h;
		cost_factor:					(Downer_Waratah_CostFactor * 2);
		running_cost_factor:			(Downer_Waratah_RunningCostFactor * 2);
		cargo_capacity: 				(Downer_Waratah_CargoCapacity / param_capacity_mod);
		power:							(Downer_Waratah_Power * 2);
		weight:							Downer_Waratah_Weight ton;

        variant_group: 					Item_Downer_Waratah_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Downer_Waratah_Liv1_frontcheck;
        purchase: 						switch_Downer_Waratah_Liv1_PurchaseStack;
        additional_text: 				string(STR_INFO_DOWNER_WARATAH);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_Downer_Waratah_Liv1_lencheck ;
        length:							Downer_Waratah_Length;
        cargo_capacity:                 [Downer_Waratah_CargoCapacity / param_capacity_mod];
        power:                          Downer_Waratah_Power;
		weight:                        	Downer_Waratah_Weight;
		running_cost_factor:            Downer_Waratah_RunningCostFactor;
}
}

