spriteset(spriteset_TullochInterurban_Liv3_lead_r,   "gfx/TullochInterurban_Liv3.png") {template_8_r(7, 39)}
spriteset(spriteset_TullochInterurban_Liv3_Trailer,   "gfx/TullochInterurban_Liv3.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_TullochInterurban_Liv3_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_TullochInterurban_Liv3_purchase;
	1: spriteset_TullochInterurban_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_TullochInterurban_Liv3_MotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_TullochInterurban_Liv3_lead;
	1: switch_TullochInterurban_Fw_railtype;
}
//C Rear
switch (FEAT_TRAINS, SELF, switch_TullochInterurban_Liv3_MotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_TullochInterurban_Liv3_lead;
	1: switch_TullochInterurban_Fw_railtype;
}

//N Lead
switch (FEAT_TRAINS, SELF, switch_TullochInterurban_Liv3_NonControlMotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_TullochInterurban_Liv3_lead;
	1: switch_TullochInterurban_Fw_railtype;
}
//N Rear
switch (FEAT_TRAINS, SELF, switch_TullochInterurban_Liv3_NonControlMotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_TullochInterurban_Liv3_lead_r;
	1: switch_TullochInterurban_Rw_railtype;
}

//Midcars
switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_pantocheck_at_2, position_in_vehid_chain % 3){
    2 : switch_TullochInterurban_Liv3_NonControlMotorStack_r;
    return spriteset_TullochInterurban_Liv3_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_pantocheck_at_2r, position_in_vehid_chain_from_end % 3){
    2 : switch_TullochInterurban_Liv3_NonControlMotorStack;
    return spriteset_TullochInterurban_Liv3_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_pantocheck_at_1, position_in_vehid_chain % 2){
    1 : switch_TullochInterurban_Liv3_NonControlMotorStack_r;
    return spriteset_TullochInterurban_Liv3_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_pantocheck_at_1r, position_in_vehid_chain_from_end % 2){
    1 : switch_TullochInterurban_Liv3_NonControlMotorStack;
    return spriteset_TullochInterurban_Liv3_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_sidecheck_other, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_TullochInterurban_Liv3_pantocheck_at_1;
    return sw_TullochInterurban_Liv3_pantocheck_at_1r;
}

switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_sidecheck_4, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_TullochInterurban_Liv3_pantocheck_at_1;
    return spriteset_TullochInterurban_Liv3_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_sidecheck_6, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_TullochInterurban_Liv3_pantocheck_at_2;
    return sw_TullochInterurban_Liv3_pantocheck_at_2r;
}

switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_lencheck, num_vehs_in_vehid_chain ) {
    0 .. 2 : spriteset_TullochInterurban_Liv3_Trailer;
    3 : sw_TullochInterurban_Liv3_pantocheck_at_1;
    4 : sw_TullochInterurban_Liv3_sidecheck_4;
    5 : sw_TullochInterurban_Liv3_pantocheck_at_2;
    6 .. 7 : sw_TullochInterurban_Liv3_sidecheck_6;
    return sw_TullochInterurban_Liv3_sidecheck_other;
}

switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_panto_direction, vehicle_is_flipped){
    0 : switch_TullochInterurban_Liv3_MotorStack;        //Front panto
    return switch_TullochInterurban_Liv3_MotorStack_r;    //Rear panto
}

switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_panto_flipcheck, vehicle_is_flipped){
    0 : sw_TullochInterurban_Liv3_panto_direction;        //Not flipped, give Panto
    return spriteset_TullochInterurban_Liv3_lead;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, sw_TullochInterurban_Liv3_frontcheck, position_in_vehid_chain){
    0: sw_TullochInterurban_Liv3_panto_direction; //We need a pantograph, guaranteed
    return sw_TullochInterurban_Liv3_panto_flipcheck; //More Checks
}

const TullochInterurban_ID_Liv3 = (TullochInterurban_ID + Liv3_ID);

item(FEAT_TRAINS, Item_TullochInterurban_Liv3, TullochInterurban_ID_Liv3) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_FictionalDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_TULLOCHINTERURBAN);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              TullochInterurban_IntroDate;		
		length:                         TullochInterurban_Length;
		
		loading_speed:					SD_Intercity_LoadingSpeed;
		speed:							TullochInterurban_Speed km/h;
		cost_factor:					(TullochInterurban_CostFactor * 2);
		running_cost_factor:			(TullochInterurban_RunningCostFactor * 2);
		cargo_capacity: 				(TullochInterurban_CargoCapacity / param_capacity_mod);
		power:							(TullochInterurban_Power * 2);
		weight:							TullochInterurban_Weight ton;

        variant_group: 					Item_TullochInterurban_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_TullochInterurban_Liv3_frontcheck;
        purchase: 						switch_TullochInterurban_Liv3_PurchaseStack;
        additional_text: 				string(STR_INFO_TULLOCHINTERURBAN);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_TullochInterurban_Liv3_lencheck ;
        length:							TullochInterurban_Length;
        cargo_capacity:                 [TullochInterurban_CargoCapacity / param_capacity_mod];
        power:                          TullochInterurban_Power;
		weight:                        	TullochInterurban_Weight;
		running_cost_factor:            TullochInterurban_RunningCostFactor;
    }
}

