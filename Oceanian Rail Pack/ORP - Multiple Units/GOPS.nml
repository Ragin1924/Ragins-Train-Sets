spriteset(spriteset_CAF_CxK_PantoUp_r,   "gfx/CAF_CxK_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_CAF_CxK_Fw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_CAF_CxK_PantoDown;
 1: spriteset_CAF_CxK_PantoUp;
}

//CAF_CxK_Liv0
spriteset(spriteset_CAF_CxK_Liv0_purchase,   "gfx/CAF_CxK_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_CAF_CxK_Liv0_lead,   "gfx/CAF_CxK_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_CAF_CxK_Liv0_lead_r,   "gfx/CAF_CxK_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_CAF_CxK_Liv0_Trailer,   "gfx/CAF_CxK_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_CAF_CxK_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_CAF_CxK_Liv0_purchase;
	1: spriteset_CAF_CxK_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_CAF_CxK_Liv0_LeadStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_CAF_CxK_Liv0_lead;
	1: switch_CAF_CxK_Fw_railtype;
}

//End Car Controls
switch(FEAT_TRAINS, SELF, switch_CAF_CxK_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : switch_CAF_CxK_Liv0_LeadStack;
    return spriteset_CAF_CxK_Liv0_lead;
}

const CAF_CxK_ID_Liv0 = (CAF_CxK_ID + Liv0_ID);

item(FEAT_TRAINS, Item_CAF_CxK_Liv0, CAF_CxK_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     NG_RAIL_OHLE_AC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_ProposalDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_CAF_CXK);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              CAF_CxK_IntroDate;		
		length:                         CAF_CxK_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							CAF_CxK_Speed km/h;
		cost_factor:					(CAF_CxK_CostFactor * 2);
		running_cost_factor:			(CAF_CxK_RunningCostFactor * 2);
		cargo_capacity: 				(CAF_CxK_CargoCapacity / param_capacity_mod);
		power:							(CAF_CxK_Power * 2);
		weight:							CAF_CxK_Weight ton;

//        variant_group: 					Item_CAF_CxK_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_CAF_CxK_Liv0_panto_flipcheck;
        purchase: 						switch_CAF_CxK_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_CAF_CXK);
    }
    livery_override (Item_MU_Trailer){
        default:						spriteset_CAF_CxK_Liv0_Trailer;
        length:							CAF_CxK_Length;
        cargo_capacity:                 [CAF_CxK_CargoCapacity / param_capacity_mod];
        power:                          CAF_CxK_Power;
		weight:                        	CAF_CxK_Weight;
		running_cost_factor:            CAF_CxK_RunningCostFactor;
    }
}

