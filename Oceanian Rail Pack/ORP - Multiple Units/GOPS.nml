    0..1973: spriteset_Comeng_SSet_Liv0_purchase_S1;
	1974..2100: spriteset_Comeng_SSet_Liv0_purchase_S2;
  return spriteset_Comeng_SSet_Liv0_purchase_S2;
}

//Motor Cars
//Forward
random_switch(FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv0_Transition_Motor_Random){
    1 : spriteset_Comeng_SSet_Liv0_lead_S1;
	3 : spriteset_Comeng_SSet_Liv0_lead_S2;
}

switch(FEAT_TRAINS, PARENT, switch_Comeng_SSet_Liv0_Transition_Motor, date_of_last_service) {
    0..date(1973, 12, 31): spriteset_Comeng_SSet_Liv0_lead_S1;
	date(1974, 1, 1)..date(2100, 1, 1): switch_Comeng_SSet_Liv0_Transition_Motor_Random;
  return switch_Comeng_SSet_Liv0_Transition_Motor_Random;
}

//Backward
