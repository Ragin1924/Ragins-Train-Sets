spriteset(spriteset_Eveleigh_NWC_Liv0_lead,   "gfx/Eveleigh_NWC_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_Eveleigh_NWC_Liv0_Trailer,   "gfx/Eveleigh_NWC_Liv0.png") {template_8_repeat(7, 69)}

const Eveleigh_NWC_ID_Liv0 = (Eveleigh_NWC_ID + Liv0_ID );

item(FEAT_TRAINS, Item_Eveleigh_NWC_Liv0, Eveleigh_NWC_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     RAIL;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_DIESEL;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_ProposalDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_DIESEL;

        name:                           string(STR_NAME_EVELEIGH_NWC);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Eveleigh_NWC_IntroDate;		
		length:                         Eveleigh_NWC_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Eveleigh_NWC_Speed km/h;
		cost_factor:					(Eveleigh_NWC_CostFactor * 2);
		running_cost_factor:			(Eveleigh_NWC_RunningCostFactor * 2);
		cargo_capacity: 				(Eveleigh_NWC_CargoCapacity / param_capacity_mod);
		power:							(Eveleigh_NWC_Power * 2);
		weight:							Eveleigh_NWC_Weight ton;

//        variant_group: 					Item_Eveleigh_NWC_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						spriteset_Eveleigh_NWC_Liv0_lead;
        purchase: 						spriteset_Eveleigh_NWC_Liv0_purchase;
        additional_text: 				string(STR_INFO_EVELEIGH_NWC);
    }
    livery_override (Item_MU_Trailer){
        default: 						spriteset_Eveleigh_NWC_Liv0_Trailer ;
        length: 						8;
        cargo_capacity:                 (Eveleigh_NWC_CargoCapacity / param_capacity_mod);
        power:                          Eveleigh_NWC_Power;
		weight:                        	Eveleigh_NWC_Weight;
		running_cost_factor:            Eveleigh_NWC_RunningCostFactor;
    }
}

