        name:                           string(STR_NAME_COMENG_THAIXPT);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Comeng_ThaiXPT_IntroDate;		
		length:                         8;
		
		loading_speed:					SD_Express_LoadingSpeed;
