		cost_factor:					(Comeng_ThaiXPT_CostFactor * 2);
		running_cost_factor:			(Comeng_ThaiXPT_RunningCostFactor * 2);
		cargo_capacity: 				0;
		power:							Comeng_ThaiXPT_Power;
		weight:							Comeng_ThaiXPT_Weight ton;

//        variant_group: 					Item_Comeng_ThaiXPT_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						spriteset_Comeng_ThaiXPT_Liv0_lead;
        purchase: 						spriteset_Comeng_ThaiXPT_Liv0_purchase;
        additional_text: 				string(STR_INFO_COMENG_THAIXPT);
    }
    livery_override (Item_MU_Trailer){
        default: 						switch_Comeng_ThaiXPT_Liv0_Trailer ;
        length: 						8;
        cargo_capacity:                 (Comeng_ThaiXPT_CargoCapacity / param_capacity_mod);
        power:                          0;
		weight:                        	Comeng_ThaiXPT_Weight_T;
		running_cost_factor:            (Comeng_ThaiXPT_RunningCostFactor / 2); //maybe remove the divide?

    }
}