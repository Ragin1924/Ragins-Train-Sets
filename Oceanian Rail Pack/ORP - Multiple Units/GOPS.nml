switch(FEAT_TRAINS, PARENT, switch_TaitInterurban_Roof_Transition_Trailer, date_of_last_service) {
    0..date(1928, 12, 31): spriteset_TaitInterurban_Roof1_Trailer;
	date(1929, 1, 1)..date(2100, 1, 1): switch_TaitInterurban_Roof_Transition_Trailer_Random;
  return switch_TaitInterurban_Roof_Transition_Trailer_Random;
}

//TaitInterurban_Liv0
spriteset(spriteset_TaitInterurban_Liv0_purchase,   "gfx/TaitInterurban_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_TaitInterurban_Liv0_lead,   "gfx/TaitInterurban_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_TaitInterurban_Liv0_lead_r,   "gfx/TaitInterurban_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_TaitInterurban_Liv0_Trailer,   "gfx/TaitInterurban_Liv0.png") {template_8_repeat(7, 69)}

spriteset(spriteset_TaitInterurban_Liv0_single_purchase,   "gfx/TaitInterurban_Liv0.png") {template_purchase_8(187, 21)}
spriteset(spriteset_TaitInterurban_Liv0_single,   "gfx/TaitInterurban_Liv0.png") {template_8(187, 39)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_TaitInterurban_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_TaitInterurban_Liv0_purchase;
	1: switch_TaitInterurban_Roof_Transition_Purchase;
	2: spriteset_TaitInterurban_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_TaitInterurban_Liv0_MotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_TaitInterurban_Liv0_lead;
	1: switch_TaitInterurban_Roof_Transition_Motor;
	2: switch_TaitInterurban_Fw_railtype;
}
//C Rear
switch (FEAT_TRAINS, SELF, switch_TaitInterurban_Liv0_MotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_TaitInterurban_Liv0_lead;
	1: switch_TaitInterurban_Roof_Transition_Motor;
	2: switch_TaitInterurban_Fw_railtype;
}

//D Lead
switch (FEAT_TRAINS, SELF, switch_TaitInterurban_Liv0_DrivingTrailerStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_TaitInterurban_Liv0_lead;
	1: switch_TaitInterurban_Roof_Transition_Motor;
}

//N Lead
switch (FEAT_TRAINS, SELF, switch_TaitInterurban_Liv0_NonControlMotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
