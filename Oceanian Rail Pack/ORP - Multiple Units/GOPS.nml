		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_ALSTOM_CSERIES);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Alstom_CSeries_IntroDate;		
		length:                         Alstom_CSeries_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Alstom_CSeries_Speed km/h;
		cost_factor:					(Alstom_CSeries_CostFactor * 2);
		running_cost_factor:			(Alstom_CSeries_RunningCostFactor * 2);
		cargo_capacity: 				(Alstom_CSeries_CargoCapacity / param_capacity_mod);
		power:							(Alstom_CSeries_Power * 2);
		weight:							Alstom_CSeries_Weight ton;

//        variant_group: 					Item_Alstom_CSeries_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_Alstom_CSeries_Liv0_endcars;
        purchase: 						switch_Alstom_CSeries_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_ALSTOM_CSERIES);
    }
    livery_override (Item_MU_Trailer){
        default:						switch_Alstom_CSeries_Liv0_midcars;
        length:							Alstom_CSeries_Length;
        cargo_capacity:                 [Alstom_CSeries_CargoCapacity / param_capacity_mod];
        power:                          Alstom_CSeries_Power;
		weight:                        	Alstom_CSeries_Weight;
		running_cost_factor:            Alstom_CSeries_RunningCostFactor;
}
}

