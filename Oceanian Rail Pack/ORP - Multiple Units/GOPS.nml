const NZ_GanzMavag_ID_Liv1 = (NZ_GanzMavag_ID + Liv1_ID);

item(FEAT_TRAINS, Item_NZ_GanzMavag_Liv1, NZ_GanzMavag_ID_Liv1) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     NG_RAIL_OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_NZ_GANZMAVAG);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              NZ_GanzMavag_IntroDate;		
		length:                         NZ_GanzMavag_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							NZ_GanzMavag_Speed km/h;
		cost_factor:					(NZ_GanzMavag_CostFactor * 2);
		running_cost_factor:			(NZ_GanzMavag_RunningCostFactor * 2);
		cargo_capacity: 				(NZ_GanzMavag_CargoCapacity / param_capacity_mod);
		power:							(NZ_GanzMavag_Power * 2);
		weight:							NZ_GanzMavag_Weight ton;

        variant_group: 					Item_NZ_GanzMavag_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_NZ_GanzMavag_Liv1_frontcheck;
        purchase: 						switch_NZ_GanzMavag_Liv1_PurchaseStack;
        additional_text: 				string(STR_INFO_NZ_GANZMAVAG);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_NZ_GanzMavag_Liv1_lencheck ;
        length:							NZ_GanzMavag_Length;
        cargo_capacity:                 [NZ_GanzMavag_CargoCapacity / param_capacity_mod];
        power:                          NZ_GanzMavag_Power;
		weight:                        	NZ_GanzMavag_Weight;
		running_cost_factor:            NZ_GanzMavag_RunningCostFactor;
    }
}

