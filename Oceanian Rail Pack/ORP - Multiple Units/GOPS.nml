item(FEAT_TRAINS, Item_Comeng_SSet_Liv0, Comeng_SSet_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_COMENG_SSET);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Comeng_SSet_IntroDate;		
		length:                         Comeng_SSet_Length;
		
		loading_speed:					DD_Suburban_LoadingSpeed;
		speed:							Comeng_SSet_Speed km/h;
		cost_factor:					(Comeng_SSet_CostFactor * 2);
		running_cost_factor:			(Comeng_SSet_RunningCostFactor * 2);
		cargo_capacity: 				(Comeng_SSet_CargoCapacity / param_capacity_mod);
		power:							(Comeng_SSet_Power * 2);
		weight:							Comeng_SSet_Weight ton;

//        variant_group: 					Item_Comeng_SSet_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Comeng_SSet_Liv0_frontcheck;
        purchase: 						switch_Comeng_SSet_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_COMENG_SSET);
    }
    livery_override (Item_MU_Trailer){
        default: 						sw_Comeng_SSet_Liv0_lencheck ;
        length: 						8;
        cargo_capacity:                 (Comeng_SSet_CargoCapacity / param_capacity_mod);
        power:                          Comeng_SSet_Power;
		weight:                        	Comeng_SSet_Weight;
		running_cost_factor:            Comeng_SSet_RunningCostFactor;
    }
}

//Comeng_SSet_Liv1
spriteset(spriteset_Comeng_SSet_Liv1_purchase_S1,   "gfx/Comeng_SSet_Liv1A.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Comeng_SSet_Liv1_purchase_S2,   "gfx/Comeng_SSet_Liv1A.png") {template_purchase_88mu(187, 21)}

spriteset(spriteset_Comeng_SSet_Liv1A_lead_S1,   "gfx/Comeng_SSet_Liv1A.png") {template_8(7, 39)}
spriteset(spriteset_Comeng_SSet_Liv1A_lead_S2,   "gfx/Comeng_SSet_Liv1A.png") {template_8(7, 69)}
spriteset(spriteset_Comeng_SSet_Liv1A_lead_S1_r,   "gfx/Comeng_SSet_Liv1A.png") {template_8_r(7, 39)}
spriteset(spriteset_Comeng_SSet_Liv1A_lead_S2_r,   "gfx/Comeng_SSet_Liv1A.png") {template_8_r(7, 69)}
spriteset(spriteset_Comeng_SSet_Liv1A_Trailer_Tulloch,   "gfx/Comeng_SSet_Liv1A.png") {template_8_repeat(7, 99)}
spriteset(spriteset_Comeng_SSet_Liv1A_Trailer_Normal,   "gfx/Comeng_SSet_Liv1A.png") {template_8_repeat(7, 129)}

spriteset(spriteset_Comeng_SSet_Liv1B_lead_S1,   "gfx/Comeng_SSet_Liv1B.png") {template_8(7, 39)}
spriteset(spriteset_Comeng_SSet_Liv1B_lead_S2,   "gfx/Comeng_SSet_Liv1B.png") {template_8(7, 69)}
spriteset(spriteset_Comeng_SSet_Liv1B_lead_S1_r,   "gfx/Comeng_SSet_Liv1B.png") {template_8_r(7, 39)}
spriteset(spriteset_Comeng_SSet_Liv1B_lead_S2_r,   "gfx/Comeng_SSet_Liv1B.png") {template_8_r(7, 69)}
spriteset(spriteset_Comeng_SSet_Liv1B_Trailer_Tulloch,   "gfx/Comeng_SSet_Liv1B.png") {template_8_repeat(7, 99)}
spriteset(spriteset_Comeng_SSet_Liv1B_Trailer_Normal,   "gfx/Comeng_SSet_Liv1B.png") {template_8_repeat(7, 129)}

//Purchase timeline
switch(FEAT_TRAINS, PARENT, switch_Comeng_SSet_Liv1_Timeline_Purchase, current_year) {
    0..1973: spriteset_Comeng_SSet_Liv1_purchase_S1;
	1974..2100: spriteset_Comeng_SSet_Liv1_purchase_S2;
  return spriteset_Comeng_SSet_Liv1_purchase_S2;
}

//Motor Cars
//Forward
random_switch(FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_S1_Motor_Random){
    1 : spriteset_Comeng_SSet_Liv1A_lead_S1;
	1 : spriteset_Comeng_SSet_Liv1B_lead_S1;
}

random_switch(FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_S2_Motor_Random){
    1 : spriteset_Comeng_SSet_Liv1A_lead_S2;
	1 : spriteset_Comeng_SSet_Liv1B_lead_S2;
}

random_switch(FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_S1_Motor_Random_r){
    1 : spriteset_Comeng_SSet_Liv1A_lead_S1_r;
	1 : spriteset_Comeng_SSet_Liv1B_lead_S1_r;
}

random_switch(FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_S2_Motor_Random_r){
    1 : spriteset_Comeng_SSet_Liv1A_lead_S2_r;
	1 : spriteset_Comeng_SSet_Liv1B_lead_S2_r;
}

random_switch(FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_Transition_Motor_Random){
    1 : switch_Comeng_SSet_Liv1_S1_Motor_Random;
	3 : switch_Comeng_SSet_Liv1_S2_Motor_Random;
}

switch(FEAT_TRAINS, PARENT, switch_Comeng_SSet_Liv1_Transition_Motor, date_of_last_service) {
    0..date(1973, 12, 31): switch_Comeng_SSet_Liv1_S1_Motor_Random;
	date(1974, 1, 1)..date(2100, 1, 1): switch_Comeng_SSet_Liv1_Transition_Motor_Random;
  return switch_Comeng_SSet_Liv1_Transition_Motor_Random;
}

//Backward
random_switch(FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_Transition_Motor_Random_r){
    1 : switch_Comeng_SSet_Liv1_S1_Motor_Random_r;
	3 : switch_Comeng_SSet_Liv1_S2_Motor_Random_r;
}

switch(FEAT_TRAINS, PARENT, switch_Comeng_SSet_Liv1_Transition_Motor_r, date_of_last_service) {
    0..date(1973, 12, 31): switch_Comeng_SSet_Liv1_S1_Motor_Random_r;
	date(1974, 1, 1)..date(2100, 1, 1): switch_Comeng_SSet_Liv1_Transition_Motor_Random_r;
  return switch_Comeng_SSet_Liv1_Transition_Motor_Random_r;
}

//Trailer Cars
random_switch(FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_Tulloch_Trailer_Random){
    1 : spriteset_Comeng_SSet_Liv1A_Trailer_Tulloch;
	1 : spriteset_Comeng_SSet_Liv1B_Trailer_Tulloch;
}

random_switch(FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_Normal_Trailer_Random){
    1 : spriteset_Comeng_SSet_Liv1A_Trailer_Normal;
	1 : spriteset_Comeng_SSet_Liv1B_Trailer_Normal;
}

random_switch(FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_Transition_Trailer_Random){
    1 : switch_Comeng_SSet_Liv1_Tulloch_Trailer_Random;
	3 : switch_Comeng_SSet_Liv1_Normal_Trailer_Random;
}

switch(FEAT_TRAINS, PARENT, switch_Comeng_SSet_Liv1_Transition_Trailer, date_of_last_service) {
    0..date(1973, 12, 31): switch_Comeng_SSet_Liv1_Tulloch_Trailer_Random;
	date(1974, 1, 1)..date(2004, 1, 1): switch_Comeng_SSet_Liv1_Transition_Trailer_Random;
  return switch_Comeng_SSet_Liv1_Normal_Trailer_Random;
}
//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Comeng_SSet_Liv1_Timeline_Purchase;
	1: spriteset_Comeng_SSet_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_MotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Comeng_SSet_Liv1_Transition_Motor;
	1: switch_Comeng_SSet_Fw_railtype;
}
//C Rear
switch (FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_MotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Comeng_SSet_Liv1_Transition_Motor_r;
	1: switch_Comeng_SSet_Fw_railtype;
}

//N Lead
switch (FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_NonControlMotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Comeng_SSet_Liv1_Transition_Motor;
	1: switch_Comeng_SSet_Fw_railtype;
}
//N Rear
switch (FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv1_NonControlMotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Comeng_SSet_Liv1_Transition_Motor_r;
	1: switch_Comeng_SSet_Rw_railtype;
}

//Midcars
switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_pantocheck_at_2, position_in_vehid_chain % 3){
    2 : switch_Comeng_SSet_Liv1_NonControlMotorStack_r;
    return switch_Comeng_SSet_Liv1_Transition_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_pantocheck_at_2r, position_in_vehid_chain_from_end % 3){
    2 : switch_Comeng_SSet_Liv1_NonControlMotorStack;
    return switch_Comeng_SSet_Liv1_Transition_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_pantocheck_at_1, position_in_vehid_chain % 2){
    1 : switch_Comeng_SSet_Liv1_NonControlMotorStack_r;
    return switch_Comeng_SSet_Liv1_Transition_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_pantocheck_at_1r, position_in_vehid_chain_from_end % 2){
    1 : switch_Comeng_SSet_Liv1_NonControlMotorStack;
    return switch_Comeng_SSet_Liv1_Transition_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_sidecheck_other, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Comeng_SSet_Liv1_pantocheck_at_1;
    return sw_Comeng_SSet_Liv1_pantocheck_at_1r;
}

switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_sidecheck_4, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Comeng_SSet_Liv1_pantocheck_at_1;
    return switch_Comeng_SSet_Liv1_Transition_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_sidecheck_6, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Comeng_SSet_Liv1_pantocheck_at_2;
    return sw_Comeng_SSet_Liv1_pantocheck_at_2r;
}

switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_lencheck, num_vehs_in_vehid_chain ) {
    0 .. 2 : switch_Comeng_SSet_Liv1_Transition_Trailer;
    3 : sw_Comeng_SSet_Liv1_pantocheck_at_1;
    4 : sw_Comeng_SSet_Liv1_sidecheck_4;
    5 : sw_Comeng_SSet_Liv1_pantocheck_at_2;
    6 .. 7 : sw_Comeng_SSet_Liv1_sidecheck_6;
    return sw_Comeng_SSet_Liv1_sidecheck_other;
}

//Endcars
switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_panto_direction, vehicle_is_flipped){
    0 : switch_Comeng_SSet_Liv1_MotorStack;        //Front panto
    return switch_Comeng_SSet_Liv1_MotorStack_r;    //Rear panto
}

switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_panto_flipcheck, vehicle_is_flipped){
    0 : sw_Comeng_SSet_Liv1_panto_direction;        //Not flipped, give Panto
    return switch_Comeng_SSet_Liv1_Transition_Motor;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv1_frontcheck, position_in_vehid_chain){
    0: sw_Comeng_SSet_Liv1_panto_direction; //We need a pantograph, guaranteed
    return sw_Comeng_SSet_Liv1_panto_flipcheck; //More Checks
}

const Comeng_SSet_ID_Liv1 = (Comeng_SSet_ID + Liv1_ID );

item(FEAT_TRAINS, Item_Comeng_SSet_Liv1, Comeng_SSet_ID_Liv1) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_COMENG_SSET);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Comeng_SSet_IntroDate;		
		length:                         Comeng_SSet_Length;
		
		loading_speed:					DD_Suburban_LoadingSpeed;
		speed:							Comeng_SSet_Speed km/h;
		cost_factor:					(Comeng_SSet_CostFactor * 2);
		running_cost_factor:			(Comeng_SSet_RunningCostFactor * 2);
		cargo_capacity: 				(Comeng_SSet_CargoCapacity / param_capacity_mod);
		power:							(Comeng_SSet_Power * 2);
		weight:							Comeng_SSet_Weight ton;

        variant_group: 					Item_Comeng_SSet_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Comeng_SSet_Liv1_frontcheck;
        purchase: 						switch_Comeng_SSet_Liv1_PurchaseStack;
        additional_text: 				string(STR_INFO_COMENG_SSET);
    }
    livery_override (Item_MU_Trailer){
        default: 						sw_Comeng_SSet_Liv1_lencheck ;
        length: 						8;
        cargo_capacity:                 (Comeng_SSet_CargoCapacity / param_capacity_mod);
        power:                          Comeng_SSet_Power;
		weight:                        	Comeng_SSet_Weight;
		running_cost_factor:            Comeng_SSet_RunningCostFactor;
    }
}

