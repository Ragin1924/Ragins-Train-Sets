const Siemens_Nexas_ID_Liv0 = (Siemens_Nexas_ID + Liv0_ID);

item(FEAT_TRAINS, Item_Siemens_Nexas_Liv0, Siemens_Nexas_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     BG_RAIL_OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_PrototypeDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_SIEMENS_NEXAS);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Siemens_Nexas_IntroDate;		
		length:                         Siemens_Nexas_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Siemens_Nexas_Speed km/h;
		cost_factor:					(Siemens_Nexas_CostFactor * 2);
		running_cost_factor:			(Siemens_Nexas_RunningCostFactor * 2);
		cargo_capacity: 				(Siemens_Nexas_CargoCapacity / param_capacity_mod);
		power:							(Siemens_Nexas_Power * 2);
		weight:							Siemens_Nexas_Weight ton;

//        variant_group: 					Item_Siemens_Nexas_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Siemens_Nexas_Liv0_frontcheck;
        purchase: 						switch_Siemens_Nexas_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_SIEMENS_NEXAS);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_Siemens_Nexas_Liv0_lencheck ;
        length:							Siemens_Nexas_Length;
        cargo_capacity:                 [Siemens_Nexas_CargoCapacity / param_capacity_mod];
        power:                          Siemens_Nexas_Power;
		weight:                        	Siemens_Nexas_Weight;
		running_cost_factor:            Siemens_Nexas_RunningCostFactor;
}
}

