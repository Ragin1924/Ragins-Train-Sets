spriteset(spriteset_Comeng_HPTRegional_OHLE_Liv0_Trailer,   "gfx/Comeng_HPTRegional_OHLE_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_Comeng_HPTRegional_OHLE_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Comeng_HPTRegional_OHLE_Liv0_purchase;
	1: spriteset_Comeng_HPTRegional_OHLE_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_Comeng_HPTRegional_OHLE_Liv0_LeadStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Comeng_HPTRegional_OHLE_Liv0_lead;
	1: switch_Comeng_HPTRegional_OHLE_Fw_railtype_AC;
}

//Pantograph cars
//Swap normal & _r cars to swap pantograph arrangements
switch (FEAT_TRAINS, SELF, switch_Comeng_HPTRegional_OHLE_Liv0_PantoCarStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Comeng_HPTRegional_OHLE_Liv0_Trailer;
	1: switch_Comeng_HPTRegional_OHLE_Fw_railtype_AC;
}

switch (FEAT_TRAINS, SELF, switch_Comeng_HPTRegional_OHLE_Liv0_PantoCarStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Comeng_HPTRegional_OHLE_Liv0_Trailer;
	1: switch_Comeng_HPTRegional_OHLE_r_railtype_AC;
}

/* Midcars */
        // Penultipantos
        switch (FEAT_TRAINS, SELF, switch_Comeng_HPTRegional_OHLE_Liv0_pantos_large_forwards, position_in_vehid_chain ) {                
                0:  switch_Comeng_HPTRegional_OHLE_Liv0_PantoCarStack;
                switch_Comeng_HPTRegional_OHLE_Liv0_PantoCarStack_r;          
            }
        switch (FEAT_TRAINS, SELF, switch_Comeng_HPTRegional_OHLE_Liv0_forwards_length_large, (position_in_vehid_chain == 0) || (position_in_vehid_chain_from_end == 0 )) {                
                1:  switch_Comeng_HPTRegional_OHLE_Liv0_pantos_large_forwards;
                spriteset_Comeng_HPTRegional_OHLE_Liv0_Trailer;        
            }
        // Panto in Middle
        switch (FEAT_TRAINS, SELF, switch_Comeng_HPTRegional_OHLE_Liv0_forwards_length_small, (position_in_vehid_chain == position_in_vehid_chain_from_end ) || (position_in_vehid_chain - 1 == position_in_vehid_chain_from_end) ) {                
                0:  spriteset_Comeng_HPTRegional_OHLE_Liv0_Trailer;
                switch_Comeng_HPTRegional_OHLE_Liv0_PantoCarStack;                
            }
    switch (FEAT_TRAINS, SELF, switch_Comeng_HPTRegional_OHLE_Liv0_midcars, num_vehs_in_vehid_chain) {
            0..1: switch_Comeng_HPTRegional_OHLE_Liv0_forwards_length_large;
            2:  switch_Comeng_HPTRegional_OHLE_Liv0_forwards_length_small;
            switch_Comeng_HPTRegional_OHLE_Liv0_forwards_length_large;
        }

//End Car Controls
switch(FEAT_TRAINS, SELF, switch_Comeng_HPTRegional_OHLE_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : spriteset_Comeng_HPTRegional_OHLE_Liv0_lead;        //Not flipped, give Panto
    return switch_Comeng_HPTRegional_OHLE_Liv0_LeadStack;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, switch_Comeng_HPTRegional_OHLE_Liv0_endcars, position_in_vehid_chain){
    0: spriteset_Comeng_HPTRegional_OHLE_Liv0_lead; //We need a pantograph, guaranteed
    return switch_Comeng_HPTRegional_OHLE_Liv0_panto_flipcheck; //More Checks
}

