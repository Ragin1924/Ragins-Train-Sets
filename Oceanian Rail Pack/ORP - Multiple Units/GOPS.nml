spriteset(spriteset_XTrap2_PantoUp,   "gfx/XTrap2_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_XTrap2_PantoUp_r,   "gfx/XTrap2_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_XTrap2_Fw_railtype, tile_powers_railtype("BG_RAIL_OHLE_DC")) {
 0: spriteset_XTrap2_PantoDown;
 1: spriteset_XTrap2_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_XTrap2_Rw_railtype, tile_powers_railtype("BG_RAIL_OHLE_DC")) {
 0: spriteset_XTrap2_PantoDown_r; //might need switching back to just panto down
 1: spriteset_XTrap2_PantoUp_r;
}

//XTrap2_Liv0
spriteset(spriteset_XTrap2_Liv0_purchase,   "gfx/XTrap2_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_XTrap2_Liv0_lead,   "gfx/XTrap2_Liv0.png") {template_8(7, 39)}
