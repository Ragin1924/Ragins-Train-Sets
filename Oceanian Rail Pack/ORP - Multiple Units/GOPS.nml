//ID
const Walkers_ICE_ID = 13140;
//introduction_date
const Walkers_ICE_IntroDate = date(1988, 1, 1);
//speed
const Walkers_ICE_Speed = 120;
//cost_factor
const Walkers_ICE_CostFactor = 29;
//running_cost_factor
const Walkers_ICE_RunningCostFactor = 75;
//Cargo Capacity
const Walkers_ICE_CargoCapacity = 92;
//power
const Walkers_ICE_Power = 725;
//weight
const Walkers_ICE_Weight = 48;
//length
const Walkers_ICE_Length = 8;

