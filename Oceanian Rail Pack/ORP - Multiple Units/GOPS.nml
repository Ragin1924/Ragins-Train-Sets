spriteset(spriteset_Bombardier_ACity_Liv0_Trailer,   "gfx/Bombardier_ACity_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_Bombardier_ACity_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Bombardier_ACity_Liv0_purchase;
	1: spriteset_Bombardier_ACity_Panto_Purchase;
