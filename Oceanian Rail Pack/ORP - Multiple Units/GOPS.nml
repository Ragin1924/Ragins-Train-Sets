		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Siemens_Nexas_Speed km/h;
		cost_factor:					(Siemens_Nexas_CostFactor * 2);
		running_cost_factor:			(Siemens_Nexas_RunningCostFactor * 2);
		cargo_capacity: 				(Siemens_Nexas_CargoCapacity / param_capacity_mod);
		power:							(Siemens_Nexas_Power * 2);
		weight:							Siemens_Nexas_Weight ton;

        variant_group: 					Item_Siemens_Nexas_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Siemens_Nexas_Liv2_frontcheck;
        purchase: 						switch_Siemens_Nexas_Liv2_PurchaseStack;
        additional_text: 				string(STR_INFO_SIEMENS_NEXAS);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_Siemens_Nexas_Liv2_lencheck ;
        length:							Siemens_Nexas_Length;
        cargo_capacity:                 [Siemens_Nexas_CargoCapacity / param_capacity_mod];
        power:                          Siemens_Nexas_Power;
		weight:                        	Siemens_Nexas_Weight;
		running_cost_factor:            Siemens_Nexas_RunningCostFactor;
}
}

//Siemens_Nexas_Liv3
spriteset(spriteset_Siemens_Nexas_Liv3_purchase,   "gfx/Siemens_Nexas_Liv3.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Siemens_Nexas_Liv3_lead,   "gfx/Siemens_Nexas_Liv3.png") {template_8(7, 39)}
spriteset(spriteset_Siemens_Nexas_Liv3_lead_r,   "gfx/Siemens_Nexas_Liv3.png") {template_8_r(7, 39)}
spriteset(spriteset_Siemens_Nexas_Liv3_Trailer,   "gfx/Siemens_Nexas_Liv3.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_Siemens_Nexas_Liv3_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Siemens_Nexas_Liv3_purchase;
	1: spriteset_Siemens_Nexas_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_Siemens_Nexas_Liv3_MotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Siemens_Nexas_Liv3_lead;
	1: switch_Siemens_Nexas_Fw_railtype;
}
//C Rear
switch (FEAT_TRAINS, SELF, switch_Siemens_Nexas_Liv3_MotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Siemens_Nexas_Liv3_lead;
	1: switch_Siemens_Nexas_Fw_railtype;
}

//N Lead
switch (FEAT_TRAINS, SELF, switch_Siemens_Nexas_Liv3_NonControlMotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Siemens_Nexas_Liv3_Trailer;
	1: switch_Siemens_Nexas_Fw_railtype;
}
//N Rear
switch (FEAT_TRAINS, SELF, switch_Siemens_Nexas_Liv3_NonControlMotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Siemens_Nexas_Liv3_Trailer;
	1: switch_Siemens_Nexas_Rw_railtype;
}

//Midcars
switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_pantocheck_at_2, position_in_vehid_chain % 3){
    2 : switch_Siemens_Nexas_Liv3_NonControlMotorStack_r;
    return spriteset_Siemens_Nexas_Liv3_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_pantocheck_at_2r, position_in_vehid_chain_from_end % 3){
    2 : switch_Siemens_Nexas_Liv3_NonControlMotorStack;
    return spriteset_Siemens_Nexas_Liv3_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_pantocheck_at_1, position_in_vehid_chain % 2){
    1 : switch_Siemens_Nexas_Liv3_NonControlMotorStack_r;
    return spriteset_Siemens_Nexas_Liv3_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_pantocheck_at_1r, position_in_vehid_chain_from_end % 2){
    1 : switch_Siemens_Nexas_Liv3_NonControlMotorStack;
    return spriteset_Siemens_Nexas_Liv3_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_sidecheck_other, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Siemens_Nexas_Liv3_pantocheck_at_1;
    return sw_Siemens_Nexas_Liv3_pantocheck_at_1r;
}

switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_sidecheck_4, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Siemens_Nexas_Liv3_pantocheck_at_1;
    return spriteset_Siemens_Nexas_Liv3_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_sidecheck_6, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Siemens_Nexas_Liv3_pantocheck_at_2;
    return sw_Siemens_Nexas_Liv3_pantocheck_at_2r;
}

switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_lencheck, num_vehs_in_vehid_chain ) {
    0 .. 2 : spriteset_Siemens_Nexas_Liv3_Trailer;
    3 : sw_Siemens_Nexas_Liv3_pantocheck_at_1;
    4 : sw_Siemens_Nexas_Liv3_sidecheck_4;
    5 : sw_Siemens_Nexas_Liv3_pantocheck_at_2;
    6 .. 7 : sw_Siemens_Nexas_Liv3_sidecheck_6;
    return sw_Siemens_Nexas_Liv3_sidecheck_other;
}

//Endcars
switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_panto_direction, vehicle_is_flipped){
    0 : switch_Siemens_Nexas_Liv3_MotorStack;        //Front panto
    return switch_Siemens_Nexas_Liv3_MotorStack_r;    //Rear panto
}

switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_panto_flipcheck, vehicle_is_flipped){
    0 : sw_Siemens_Nexas_Liv3_panto_direction;        //Not flipped, give Panto
    return spriteset_Siemens_Nexas_Liv3_lead;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, sw_Siemens_Nexas_Liv3_frontcheck, position_in_vehid_chain){
    0: sw_Siemens_Nexas_Liv3_panto_direction; //We need a pantograph, guaranteed
    return sw_Siemens_Nexas_Liv3_panto_flipcheck; //More Checks
}

const Siemens_Nexas_ID_Liv3 = (Siemens_Nexas_ID + Liv3_ID);

item(FEAT_TRAINS, Item_Siemens_Nexas_Liv3, Siemens_Nexas_ID_Liv3) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     BG_RAIL_OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_PrototypeDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_SIEMENS_NEXAS);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Siemens_Nexas_IntroDate;		
		length:                         Siemens_Nexas_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Siemens_Nexas_Speed km/h;
		cost_factor:					(Siemens_Nexas_CostFactor * 2);
		running_cost_factor:			(Siemens_Nexas_RunningCostFactor * 2);
		cargo_capacity: 				(Siemens_Nexas_CargoCapacity / param_capacity_mod);
		power:							(Siemens_Nexas_Power * 2);
		weight:							Siemens_Nexas_Weight ton;

        variant_group: 					Item_Siemens_Nexas_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Siemens_Nexas_Liv3_frontcheck;
        purchase: 						switch_Siemens_Nexas_Liv3_PurchaseStack;
        additional_text: 				string(STR_INFO_SIEMENS_NEXAS);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_Siemens_Nexas_Liv3_lencheck ;
        length:							Siemens_Nexas_Length;
        cargo_capacity:                 [Siemens_Nexas_CargoCapacity / param_capacity_mod];
        power:                          Siemens_Nexas_Power;
		weight:                        	Siemens_Nexas_Weight;
		running_cost_factor:            Siemens_Nexas_RunningCostFactor;
}
}

//ID
const Bombardier_BSeries_ID = 11640;
//introduction_date
