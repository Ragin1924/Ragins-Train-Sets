        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Goninan_4D_IntroDate;		
		length:                         8;
		
		loading_speed:					DD_Suburban_LoadingSpeed;
		speed:							Goninan_4D_Speed km/h;
		cost_factor:					(Goninan_4D_CostFactor * 2);
		running_cost_factor:			(Goninan_4D_RunningCostFactor * 2);
		cargo_capacity: 				(Goninan_4D_CargoCapacity / param_capacity_mod);
		power:							(Goninan_4D_Power * 2);
		weight:							Goninan_4D_Weight ton;

//        variant_group: 					Item_Goninan_4D_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Goninan_4D_Liv0_frontcheck;
        purchase: 						switch_Goninan_4D_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_GONINAN_4D);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_Goninan_4D_Liv0_lencheck ;
        length:							8;
        cargo_capacity:                 [Goninan_4D_CargoCapacity / param_capacity_mod];
        power:                          Goninan_4D_Power;
		weight:                        	Goninan_4D_Weight;
		running_cost_factor:            Goninan_4D_RunningCostFactor;

    }
}

//ID
const EDi_Millenium_ID = 12340;
//introduction_date
const EDi_Millenium_IntroDate = date(2002, 1, 1);
//speed
const EDi_Millenium_Speed = 130;
//cost_factor
const EDi_Millenium_CostFactor = 38;
//running_cost_factor
const EDi_Millenium_RunningCostFactor = 98;
//Cargo Capacity
const EDi_Millenium_CargoCapacity = 181;
//power
const EDi_Millenium_Power = 300;
//weight
const EDi_Millenium_Weight = 42;

//Pantographs
spriteset(spriteset_EDi_Millenium_Panto_Purchase,   "gfx/EDi_Millenium_Pantographs.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_EDi_Millenium_PantoDown,   "gfx/EDi_Millenium_Pantographs.png") {template_8(7, 39)}
spriteset(spriteset_EDi_Millenium_PantoDown_r,   "gfx/EDi_Millenium_Pantographs.png") {template_8_r(7, 39)}
spriteset(spriteset_EDi_Millenium_PantoUp,   "gfx/EDi_Millenium_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_EDi_Millenium_PantoUp_r,   "gfx/EDi_Millenium_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_EDi_Millenium_Fw_railtype, tile_powers_railtype("OHLE_DC")) {
 0: spriteset_EDi_Millenium_PantoDown;
 1: spriteset_EDi_Millenium_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_EDi_Millenium_Rw_railtype, tile_powers_railtype("OHLE_DC")) {
 0: spriteset_EDi_Millenium_PantoDown_r;
 1: spriteset_EDi_Millenium_PantoUp_r;
}

//EDi_Millenium_Liv0
spriteset(spriteset_EDi_Millenium_Liv0_purchase,   "gfx/EDi_Millenium_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_EDi_Millenium_Liv0_lead,   "gfx/EDi_Millenium_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_EDi_Millenium_Liv0_lead_r,   "gfx/EDi_Millenium_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_EDi_Millenium_Liv0_Trailer,   "gfx/EDi_Millenium_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_EDi_Millenium_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_EDi_Millenium_Liv0_purchase;
	1: spriteset_EDi_Millenium_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_EDi_Millenium_Liv0_MotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_EDi_Millenium_Liv0_lead;
	1: switch_EDi_Millenium_Fw_railtype;
}
//C Rear
switch (FEAT_TRAINS, SELF, switch_EDi_Millenium_Liv0_MotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_EDi_Millenium_Liv0_lead;
	1: switch_EDi_Millenium_Fw_railtype;
}

//N Lead
switch (FEAT_TRAINS, SELF, switch_EDi_Millenium_Liv0_NonControlMotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_EDi_Millenium_Liv0_Trailer;
	1: switch_EDi_Millenium_Fw_railtype;
}
//N Rear
switch (FEAT_TRAINS, SELF, switch_EDi_Millenium_Liv0_NonControlMotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_EDi_Millenium_Liv0_Trailer;
	1: switch_EDi_Millenium_Rw_railtype;
}

//Midcars
switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_pantocheck_at_2, position_in_vehid_chain % 3){
    2 : switch_EDi_Millenium_Liv0_NonControlMotorStack_r;
    return spriteset_EDi_Millenium_Liv0_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_pantocheck_at_2r, position_in_vehid_chain_from_end % 3){
    2 : switch_EDi_Millenium_Liv0_NonControlMotorStack;
    return spriteset_EDi_Millenium_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_pantocheck_at_1, position_in_vehid_chain % 2){
    1 : switch_EDi_Millenium_Liv0_NonControlMotorStack_r;
    return spriteset_EDi_Millenium_Liv0_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_pantocheck_at_1r, position_in_vehid_chain_from_end % 2){
    1 : switch_EDi_Millenium_Liv0_NonControlMotorStack;
    return spriteset_EDi_Millenium_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_sidecheck_other, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_EDi_Millenium_Liv0_pantocheck_at_1;
    return sw_EDi_Millenium_Liv0_pantocheck_at_1r;
}

switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_sidecheck_4, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_EDi_Millenium_Liv0_pantocheck_at_1;
    return spriteset_EDi_Millenium_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_sidecheck_6, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_EDi_Millenium_Liv0_pantocheck_at_2;
    return sw_EDi_Millenium_Liv0_pantocheck_at_2r;
}

switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_lencheck, num_vehs_in_vehid_chain ) {
    0 .. 2 : spriteset_EDi_Millenium_Liv0_Trailer;
    3 : sw_EDi_Millenium_Liv0_pantocheck_at_1;
    4 : sw_EDi_Millenium_Liv0_sidecheck_4;
    5 : sw_EDi_Millenium_Liv0_pantocheck_at_2;
    6 .. 7 : sw_EDi_Millenium_Liv0_sidecheck_6;
    return sw_EDi_Millenium_Liv0_sidecheck_other;
}

//Endcars
switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_panto_direction, vehicle_is_flipped){
    0 : switch_EDi_Millenium_Liv0_MotorStack;        //Front panto
    return switch_EDi_Millenium_Liv0_MotorStack_r;    //Rear panto
}

switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : sw_EDi_Millenium_Liv0_panto_direction;        //Not flipped, give Panto
    return spriteset_EDi_Millenium_Liv0_lead;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, sw_EDi_Millenium_Liv0_frontcheck, position_in_vehid_chain){
    0: sw_EDi_Millenium_Liv0_panto_direction; //We need a pantograph, guaranteed
    return sw_EDi_Millenium_Liv0_panto_flipcheck; //More Checks
}

const EDi_Millenium_ID_Liv0 = (EDi_Millenium_ID + Liv0_ID);

item(FEAT_TRAINS, Item_EDi_Millenium_Liv0, EDi_Millenium_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_EDI_MILLENIUM);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              EDi_Millenium_IntroDate;		
		length:                         8;
		
		loading_speed:					DD_Suburban_LoadingSpeed;
		speed:							EDi_Millenium_Speed km/h;
		cost_factor:					(EDi_Millenium_CostFactor * 2);
		running_cost_factor:			(EDi_Millenium_RunningCostFactor * 2);
		cargo_capacity: 				(EDi_Millenium_CargoCapacity / param_capacity_mod);
		power:							(EDi_Millenium_Power * 2);
		weight:							EDi_Millenium_Weight ton;

//        variant_group: 					Item_EDi_Millenium_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_EDi_Millenium_Liv0_frontcheck;
        purchase: 						switch_EDi_Millenium_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_EDI_MILLENIUM);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_EDi_Millenium_Liv0_lencheck ;
        length:							8;
        cargo_capacity:                 [EDi_Millenium_CargoCapacity / param_capacity_mod];
        power:                          EDi_Millenium_Power;
		weight:                        	EDi_Millenium_Weight;
		running_cost_factor:            EDi_Millenium_RunningCostFactor;
    }
}

