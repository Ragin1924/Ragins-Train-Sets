    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Comeng_SSet_Liv0_Transition_Motor;
	1: switch_Comeng_SSet_Fw_railtype;
}
//C Rear
switch (FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv0_MotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Comeng_SSet_Liv0_Transition_Motor;
	1: switch_Comeng_SSet_Fw_railtype;
}

//N Lead
switch (FEAT_TRAINS, SELF, switch_Comeng_SSet_Liv0_NonControlMotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Comeng_SSet_Liv0_Transition_Motor;
