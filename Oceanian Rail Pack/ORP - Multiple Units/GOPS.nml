		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Comeng_DKVSet_IntroDate;		
		length:                         Comeng_DKVSet_Length;
		
		loading_speed:					DD_Intercity_LoadingSpeed;
		speed:							Comeng_DKVSet_Speed km/h;
		cost_factor:					(Comeng_DKVSet_CostFactor * 2);
		running_cost_factor:			(Comeng_DKVSet_RunningCostFactor * 2);
		cargo_capacity: 				(Comeng_DKVSet_CargoCapacity / param_capacity_mod);
		power:							(Comeng_DKVSet_Power * 2);
		weight:							Comeng_DKVSet_Weight ton;

        variant_group: 					Item_Comeng_DKVSet_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Comeng_DKVSet_Liv2_frontcheck;
        purchase: 						switch_Comeng_DKVSet_Liv2_PurchaseStack;
        additional_text: 				string(STR_INFO_COMENG_DKVSET);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_Comeng_DKVSet_Liv2_lencheck ;
        length:							Comeng_DKVSet_Length;
        cargo_capacity:                 [Comeng_DKVSet_CargoCapacity / param_capacity_mod];
        power:                          Comeng_DKVSet_Power;
		weight:                        	Comeng_DKVSet_Weight;
		running_cost_factor:            Comeng_DKVSet_RunningCostFactor;
}
}

