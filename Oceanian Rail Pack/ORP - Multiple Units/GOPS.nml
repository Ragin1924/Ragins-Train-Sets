const Comeng_SSet_ID_Liv4 = (Comeng_SSet_ID + Liv4_ID );

item(FEAT_TRAINS, Item_Comeng_SSet_Liv4, Comeng_SSet_ID_Liv4) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_COMENG_SSET);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Comeng_SSet_IntroDate;		
		length:                         Comeng_SSet_Length;
		
		loading_speed:					DD_Suburban_LoadingSpeed;
		speed:							Comeng_SSet_Speed km/h;
		cost_factor:					(Comeng_SSet_CostFactor * 2);
		running_cost_factor:			(Comeng_SSet_RunningCostFactor * 2);
		cargo_capacity: 				(Comeng_SSet_CargoCapacity / param_capacity_mod);
		power:							(Comeng_SSet_Power * 2);
		weight:							Comeng_SSet_Weight ton;

        variant_group: 					Item_Comeng_SSet_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Comeng_SSet_Liv4_frontcheck;
        purchase: 						switch_Comeng_SSet_Liv4_PurchaseStack;
        additional_text: 				string(STR_INFO_COMENG_SSET);
    }
    livery_override (Item_MU_Trailer){
        default: 						sw_Comeng_SSet_Liv4_lencheck ;
        length: 						8;
        cargo_capacity:                 (Comeng_SSet_CargoCapacity / param_capacity_mod);
        power:                          Comeng_SSet_Power;
		weight:                        	Comeng_SSet_Weight;
		running_cost_factor:            Comeng_SSet_RunningCostFactor;
    }
}

