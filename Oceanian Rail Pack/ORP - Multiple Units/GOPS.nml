spriteset(spriteset_Goninan_ADL_Liv3_lead,   "gfx/Goninan_ADL_Liv3.png") {template_8(7, 39)}
spriteset(spriteset_Goninan_ADL_Liv3_Trailer,   "gfx/Goninan_ADL_Liv3.png") {template_8_repeat(7, 69)}

const Goninan_ADL_ID_Liv3 = (Goninan_ADL_ID + Liv3_ID );

item(FEAT_TRAINS, Item_Goninan_ADL_Liv3, Goninan_ADL_ID_Liv3) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     NG_RAIL;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_DIESEL;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_DIESEL;

        name:                           string(STR_NAME_GONINAN_ADL);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Goninan_ADL_IntroDate;		
		length:                         Goninan_ADL_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Goninan_ADL_Speed km/h;
		cost_factor:					(Goninan_ADL_CostFactor * 2);
		running_cost_factor:			(Goninan_ADL_RunningCostFactor * 2);
		cargo_capacity: 				(Goninan_ADL_CargoCapacity / param_capacity_mod);
		power:							(Goninan_ADL_Power * 2);
		weight:							Goninan_ADL_Weight ton;

        variant_group: 					Item_Goninan_ADL_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						spriteset_Goninan_ADL_Liv3_lead;
        purchase: 						spriteset_Goninan_ADL_Liv3_purchase;
        additional_text: 				string(STR_INFO_GONINAN_ADL);
    }
    livery_override (Item_MU_Trailer){
        default: 						spriteset_Goninan_ADL_Liv3_Trailer ;
        length: 						8;
        cargo_capacity:                 (Goninan_ADL_CargoCapacity / param_capacity_mod);
        power:                          Goninan_ADL_Power;
		weight:                        	Goninan_ADL_Weight;
		running_cost_factor:            Goninan_ADL_RunningCostFactor;
}
}

