//ID
const SilverFern_ID = 8300;
//introduction_date
const SilverFern_IntroDate = date(1972, 1, 1);
//speed
const SilverFern_Speed = 115;
//cost_factor
const SilverFern_CostFactor = 30;
//running_cost_factor
const SilverFern_RunningCostFactor = 76;
//Cargo Capacity
const SilverFern_CargoCapacity = 87;
//power
const SilverFern_Power = 900;
//weight
const SilverFern_Weight = 53;
const SilverFern_Weight_T = 44;

//SilverFern_Liv0
spriteset(spriteset_SilverFern_Liv0_purchase,   "gfx/SilverFern_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_SilverFern_Liv0_lead,   "gfx/SilverFern_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_SilverFern_Liv0_DT_lead,   "gfx/SilverFern_Liv0.png") {template_8(7, 69)}
spriteset(spriteset_SilverFern_Liv0_Trailer,   "gfx/SilverFern_Liv0.png") {template_8_repeat(7, 99)}

switch(FEAT_TRAINS, SELF, switch_SilverFern_Liv0_position, vehicle_is_flipped){
    0:	spriteset_SilverFern_Liv0_lead;
    1: 	spriteset_SilverFern_Liv0_DT_lead;
}

const SilverFern_ID_Liv0 = (SilverFern_ID + Liv0_ID );

item(FEAT_TRAINS, Item_SilverFern_Liv0, SilverFern_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     NG_RAIL;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_DIESEL;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_DIESEL;

        name:                           string(STR_NAME_SILVERFERN);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              SilverFern_IntroDate;		
		length:                         8;
		
		loading_speed:					SD_Intercity_LoadingSpeed;
		speed:							SilverFern_Speed km/h;
		cost_factor:					(SilverFern_CostFactor * 2);
		running_cost_factor:			(SilverFern_RunningCostFactor * 2);
		cargo_capacity: 				(SilverFern_CargoCapacity / param_capacity_mod);
		power:							SilverFern_Power;
		weight:							SilverFern_Weight ton;

//        variant_group: 					Item_SilverFern_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_SilverFern_Liv0_position;
        purchase: 						spriteset_SilverFern_Liv0_purchase;
        additional_text: 				string(STR_INFO_SILVERFERN);
    }
    livery_override (Item_MU_Trailer){
        default: 						spriteset_SilverFern_Liv0_Trailer ;
        length: 						8;
        cargo_capacity:                 (SilverFern_CargoCapacity / param_capacity_mod);
        power:                          0;
		weight:                        	SilverFern_Weight_T;
		running_cost_factor:            (SilverFern_RunningCostFactor / 2); //maybe remove the divide?

    }
}

