    0..date(1973, 12, 31): spriteset_Comeng_SSet_Liv0_lead_S1_r;
	date(1974, 1, 1)..date(2100, 1, 1): switch_Comeng_SSet_Liv0_Transition_Motor_Random_r;
  return switch_Comeng_SSet_Liv0_Transition_Motor_Random_r;
}

