//ID
const X2000 = 15040;
//introduction_date
const X2000_IntroDate = date(1997, 1, 1);
//speed
const X2000_Speed = 210;
//cost_factor
const X2000_CostFactor = 36;
//running_cost_factor
const X2000_RunningCostFactor = 94;
//Cargo Capacity
const X2000_CargoCapacity = 77;
const X2000_CargoCapacity_Half = 39;
//power
const X2000_Power = 4370;
//weight
const X2000_Weight = 73;
const X2000_Weight_T = 44;
//length
const X2000_Length = 8;

//Pantographs
spriteset(spriteset_X2000_Panto_Purchase,   "gfx/X2000_Pantographs.png") {template_purchase_78mu(7, 21)}
spriteset(spriteset_X2000_PantoDown,   "gfx/X2000_Pantographs.png") {template_7(7, 39)}
spriteset(spriteset_X2000_PantoUp,   "gfx/X2000_Pantographs.png") {template_7(7, 69)}
spriteset(spriteset_X2000_PantoUp_Alt,   "gfx/X2000_Pantographs.png") {template_7(7, 99)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_X2000_railtype_DC, tile_powers_railtype("OHLE_DC")) {
 0: spriteset_X2000_PantoDown;
 1: spriteset_X2000_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_X2000_railtype_AC, tile_powers_railtype("OHLE_AC")) {
 0: switch_X2000_railtype_DC;
 1: spriteset_X2000_PantoUp_Alt;
}

switch(FEAT_TRAINS, SELF, switch_X2000_Length, vehicle_is_flipped){
    0:	7;
    1: 	8;
}

switch(FEAT_TRAINS, SELF, switch_X2000_Endcapacity, vehicle_is_flipped){
    0:	0;
    1: 	(X2000_CargoCapacity / param_capacity_mod);
}

//X2000_Liv0
spriteset(spriteset_X2000_Liv0_Purchase,   "gfx/X2000_Liv0.png") {template_purchase_78mu(7, 21)}
spriteset(spriteset_X2000_Liv0_Lead,   "gfx/X2000_Liv0.png") {template_7(7, 39)}
spriteset(spriteset_X2000_Liv0_DT_Lead,   "gfx/X2000_Liv0.png") {template_8(7, 69)}
spriteset(spriteset_X2000_Liv0_Trailer,   "gfx/X2000_Liv0.png") {template_8(7, 99)}
spriteset(spriteset_X2000_Liv0_Diner,   "gfx/X2000_Liv0.png") {template_8(7, 129)}

//Purchase Sprite Stacker
switch (FEAT_TRAINS, SELF, switch_X2000_Liv0_Purchase_Stack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_X2000_Liv0_Purchase;
    1: spriteset_X2000_Panto_Purchase;
}

//Power Car Stacker
switch (FEAT_TRAINS, SELF, switch_X2000_Liv0_Lead_Stack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_X2000_Liv0_Lead;
    1: switch_X2000_railtype_AC;
}

switch(FEAT_TRAINS, SELF, switch_X2000_Liv0_Endcars, vehicle_is_flipped){
    0:	switch_X2000_Liv0_Lead_Stack;
    1: 	spriteset_X2000_Liv0_DT_Lead;
}

switch(FEAT_TRAINS, SELF, switch_X2000_Liv0_Dinerposition, position_in_vehid_chain - position_in_vehid_chain_from_end){
    0..1:	spriteset_X2000_Liv0_Diner;
    spriteset_X2000_Liv0_Trailer;
}

