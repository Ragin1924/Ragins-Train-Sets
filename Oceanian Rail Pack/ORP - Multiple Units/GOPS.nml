spriteset(spriteset_Bombardier_NGR_PantoDown_r,   "gfx/Bombardier_NGR_Pantographs.png") {template_8_r(7, 39)}
spriteset(spriteset_Bombardier_NGR_PantoUp,   "gfx/Bombardier_NGR_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_Bombardier_NGR_PantoUp_r,   "gfx/Bombardier_NGR_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_Bombardier_NGR_Fw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_Bombardier_NGR_PantoDown;
 1: spriteset_Bombardier_NGR_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_Bombardier_NGR_Rw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_Bombardier_NGR_PantoDown_r; //might need switching back to just panto down
 1: spriteset_Bombardier_NGR_PantoUp_r;
}

//Bombardier_NGR_Liv0
spriteset(spriteset_Bombardier_NGR_Liv0_purchase,   "gfx/Bombardier_NGR_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Bombardier_NGR_Liv0_lead,   "gfx/Bombardier_NGR_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_Bombardier_NGR_Liv0_lead_r,   "gfx/Bombardier_NGR_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_Bombardier_NGR_Liv0_Trailer,   "gfx/Bombardier_NGR_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_Bombardier_NGR_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Bombardier_NGR_Liv0_purchase;
	1: spriteset_Bombardier_NGR_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_Bombardier_NGR_Liv0_LeadStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Bombardier_NGR_Liv0_lead;
	1: switch_Bombardier_NGR_Fw_railtype;
}

//Pantograph cars
//Swap normal & _r cars to swap pantograph arrangements
switch (FEAT_TRAINS, SELF, switch_Bombardier_NGR_Liv0_PantoCarStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Bombardier_NGR_Liv0_Trailer;
	1: switch_Bombardier_NGR_Fw_railtype;
}

switch (FEAT_TRAINS, SELF, switch_Bombardier_NGR_Liv0_PantoCarStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Bombardier_NGR_Liv0_Trailer;
	1: switch_Bombardier_NGR_Rw_railtype;
}

/* Midcars */
        // Penultipantos
        switch (FEAT_TRAINS, SELF, switch_Bombardier_NGR_Liv0_pantos_large_forwards, position_in_vehid_chain ) {                
                0:  switch_Bombardier_NGR_Liv0_PantoCarStack;
                switch_Bombardier_NGR_Liv0_PantoCarStack_r;          
            }
        switch (FEAT_TRAINS, SELF, switch_Bombardier_NGR_Liv0_forwards_length_large, (position_in_vehid_chain == 0) || (position_in_vehid_chain_from_end == 0 )) {                
                1:  switch_Bombardier_NGR_Liv0_pantos_large_forwards;
                spriteset_Bombardier_NGR_Liv0_Trailer;        
            }
        // Panto in Middle
        switch (FEAT_TRAINS, SELF, switch_Bombardier_NGR_Liv0_forwards_length_small, (position_in_vehid_chain == position_in_vehid_chain_from_end ) || (position_in_vehid_chain - 1 == position_in_vehid_chain_from_end) ) {                
                0:  spriteset_Bombardier_NGR_Liv0_Trailer;
                switch_Bombardier_NGR_Liv0_PantoCarStack;                
            }
    switch (FEAT_TRAINS, SELF, switch_Bombardier_NGR_Liv0_midcars, num_vehs_in_vehid_chain) {
            0..1: switch_Bombardier_NGR_Liv0_forwards_length_large;
            2:  switch_Bombardier_NGR_Liv0_forwards_length_small;
            switch_Bombardier_NGR_Liv0_forwards_length_large;
        }

//End Car Controls
switch(FEAT_TRAINS, SELF, switch_Bombardier_NGR_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : spriteset_Bombardier_NGR_Liv0_lead;        //Not flipped, give Panto
    return switch_Bombardier_NGR_Liv0_LeadStack;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, switch_Bombardier_NGR_Liv0_endcars, position_in_vehid_chain){
    0: spriteset_Bombardier_NGR_Liv0_lead; //We need a pantograph, guaranteed
    return switch_Bombardier_NGR_Liv0_panto_flipcheck; //More Checks
}

const Bombardier_NGR_ID_Liv0 = (Bombardier_NGR_ID + Liv0_ID);

item(FEAT_TRAINS, Item_Bombardier_NGR_Liv0, Bombardier_NGR_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_TILT,TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     NG_RAIL_OHLE_AC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_BOMBARDIER_NGR);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Bombardier_NGR_IntroDate;		
		length:                         Bombardier_NGR_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Bombardier_NGR_Speed km/h;
		cost_factor:					(Bombardier_NGR_CostFactor * 2);
		running_cost_factor:			(Bombardier_NGR_RunningCostFactor * 2);
		cargo_capacity: 				(Bombardier_NGR_CargoCapacity / param_capacity_mod);
		power:							(Bombardier_NGR_Power * 2);
		weight:							Bombardier_NGR_Weight ton;

//        variant_group: 					Item_Bombardier_NGR_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_Bombardier_NGR_Liv0_endcars;
        purchase: 						switch_Bombardier_NGR_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_BOMBARDIER_NGR);
    }
    livery_override (Item_MU_Trailer){
        default:						switch_Bombardier_NGR_Liv0_midcars;
        length:							Bombardier_NGR_Length;
        cargo_capacity:                 [Bombardier_NGR_CargoCapacity / param_capacity_mod];
        power:                          Bombardier_NGR_Power;
		weight:                        	Bombardier_NGR_Weight;
		running_cost_factor:            Bombardier_NGR_RunningCostFactor;
}
}

//ID
const CRRC_HCMT_ID = 11760;
//introduction_date
const CRRC_HCMT_IntroDate = date(2020, 1, 1);
//speed
const CRRC_HCMT_Speed = 130;
//cost_factor
const CRRC_HCMT_CostFactor = 25;
//running_cost_factor
const CRRC_HCMT_RunningCostFactor = 65;
//Cargo Capacity
const CRRC_HCMT_CargoCapacity = 121;
//power
const CRRC_HCMT_Power = 570; //MU power is for 1 vehicle
//weight
const CRRC_HCMT_Weight = 45;
//length
const CRRC_HCMT_Length = 8;

//Pantographs
spriteset(spriteset_CRRC_HCMT_Panto_Purchase,   "gfx/CRRC_HCMT_Pantographs.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_CRRC_HCMT_PantoDown,   "gfx/CRRC_HCMT_Pantographs.png") {template_8(7, 39)}
spriteset(spriteset_CRRC_HCMT_PantoDown_r,   "gfx/CRRC_HCMT_Pantographs.png") {template_8_r(7, 39)}
spriteset(spriteset_CRRC_HCMT_PantoUp,   "gfx/CRRC_HCMT_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_CRRC_HCMT_PantoUp_r,   "gfx/CRRC_HCMT_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_CRRC_HCMT_Fw_railtype, tile_powers_railtype("BG_RAIL_OHLE_DC")) {
 0: spriteset_CRRC_HCMT_PantoDown;
 1: spriteset_CRRC_HCMT_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_CRRC_HCMT_Rw_railtype, tile_powers_railtype("BG_RAIL_OHLE_DC")) {
 0: spriteset_CRRC_HCMT_PantoDown_r; //might need switching back to just panto down
 1: spriteset_CRRC_HCMT_PantoUp_r;
}

//CRRC_HCMT_Liv0
spriteset(spriteset_CRRC_HCMT_Liv0_purchase,   "gfx/CRRC_HCMT_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_CRRC_HCMT_Liv0_lead,   "gfx/CRRC_HCMT_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_CRRC_HCMT_Liv0_lead_r,   "gfx/CRRC_HCMT_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_CRRC_HCMT_Liv0_Trailer,   "gfx/CRRC_HCMT_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_CRRC_HCMT_Liv0_purchase;
	1: spriteset_CRRC_HCMT_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_LeadStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_CRRC_HCMT_Liv0_lead;
	1: switch_CRRC_HCMT_Fw_railtype;
}

//Pantograph cars
//Swap normal & _r cars to swap pantograph arrangements
switch (FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_PantoCarStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_CRRC_HCMT_Liv0_Trailer;
	1: switch_CRRC_HCMT_Fw_railtype;
}

switch (FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_PantoCarStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_CRRC_HCMT_Liv0_Trailer;
	1: switch_CRRC_HCMT_Rw_railtype;
}

/* Midcars */
        // Penultipantos
	switch (FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_pantos_large_forwards, (position_in_vehid_chain == 0) || (position_in_vehid_chain == 1) ) {
			1: switch_CRRC_HCMT_Liv0_PantoCarStack;
			spriteset_CRRC_HCMT_Liv0_Trailer;
}
	switch (FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_pantos_large_backwards, (position_in_vehid_chain_from_end == 0) || (position_in_vehid_chain_from_end == 1) ) {
			1: switch_CRRC_HCMT_Liv0_PantoCarStack_r;
			spriteset_CRRC_HCMT_Liv0_Trailer;
}
	switch (FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_forwards_length_large, (position_in_vehid_chain_from_end == 0) || (position_in_vehid_chain_from_end == 1) ) {
			1: switch_CRRC_HCMT_Liv0_pantos_large_backwards;
			switch_CRRC_HCMT_Liv0_pantos_large_forwards;
}
        // Panto in Middle
        switch (FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_forwards_length_small, (position_in_vehid_chain - position_in_vehid_chain_from_end) ) {                
                0..1:  switch_CRRC_HCMT_Liv0_PantoCarStack;
                spriteset_CRRC_HCMT_Liv0_Trailer;                
            }
    switch (FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_midcars, num_vehs_in_vehid_chain) {
            0..4: switch_CRRC_HCMT_Liv0_forwards_length_small;
            switch_CRRC_HCMT_Liv0_forwards_length_large;
        }

//End Car Controls
switch(FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : spriteset_CRRC_HCMT_Liv0_lead;        //Not flipped, give Panto
    return switch_CRRC_HCMT_Liv0_LeadStack;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, switch_CRRC_HCMT_Liv0_endcars, position_in_vehid_chain){
    0: spriteset_CRRC_HCMT_Liv0_lead; //We need a pantograph, guaranteed
    return switch_CRRC_HCMT_Liv0_panto_flipcheck; //More Checks
}

