        switch (FEAT_TRAINS, SELF, switch_Bombardier_BSeries_Liv1_forwards_length_large, (position_in_vehid_chain == 0) || (position_in_vehid_chain_from_end == 0 )) {                
                1:  switch_Bombardier_BSeries_Liv1_pantos_large_forwards;
                spriteset_Bombardier_BSeries_Liv1_Trailer;        
            }
        // Panto in Middle
        switch (FEAT_TRAINS, SELF, switch_Bombardier_BSeries_Liv1_forwards_length_small, (position_in_vehid_chain == position_in_vehid_chain_from_end ) || (position_in_vehid_chain - 1 == position_in_vehid_chain_from_end) ) {                
                0:  spriteset_Bombardier_BSeries_Liv1_Trailer;
                switch_Bombardier_BSeries_Liv1_PantoCarStack;                
            }
    switch (FEAT_TRAINS, SELF, switch_Bombardier_BSeries_Liv1_midcars, num_vehs_in_vehid_chain) {
            0..1: switch_Bombardier_BSeries_Liv1_forwards_length_large;
            2:  switch_Bombardier_BSeries_Liv1_forwards_length_small;
            switch_Bombardier_BSeries_Liv1_forwards_length_large;
        }

//End Car Controls
switch(FEAT_TRAINS, SELF, switch_Bombardier_BSeries_Liv1_panto_flipcheck, vehicle_is_flipped){
    0 : spriteset_Bombardier_BSeries_Liv1_lead;        //Not flipped, give Panto
    return switch_Bombardier_BSeries_Liv1_LeadStack;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, switch_Bombardier_BSeries_Liv1_endcars, position_in_vehid_chain){
    0: spriteset_Bombardier_BSeries_Liv1_lead; //We need a pantograph, guaranteed
    return switch_Bombardier_BSeries_Liv1_panto_flipcheck; //More Checks
}

const Bombardier_BSeries_ID_Liv1 = (Bombardier_BSeries_ID + Liv1_ID);

item(FEAT_TRAINS, Item_Bombardier_BSeries_Liv1, Bombardier_BSeries_ID_Liv1) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_TILT,TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     NG_RAIL_OHLE_AC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_BOMBARDIER_BSERIES);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Bombardier_BSeries_IntroDate;		
		length:                         Bombardier_BSeries_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Bombardier_BSeries_Speed km/h;
		cost_factor:					(Bombardier_BSeries_CostFactor * 2);
		running_cost_factor:			(Bombardier_BSeries_RunningCostFactor * 2);
		cargo_capacity: 				(Bombardier_BSeries_CargoCapacity / param_capacity_mod);
		power:							(Bombardier_BSeries_Power * 2);
		weight:							Bombardier_BSeries_Weight ton;

        variant_group: 					Item_Bombardier_BSeries_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_Bombardier_BSeries_Liv1_endcars;
        purchase: 						switch_Bombardier_BSeries_Liv1_PurchaseStack;
        additional_text: 				string(STR_INFO_BOMBARDIER_BSERIES);
    }
    livery_override (Item_MU_Trailer){
        default:						switch_Bombardier_BSeries_Liv1_midcars;
        length:							Bombardier_BSeries_Length;
        cargo_capacity:                 [Bombardier_BSeries_CargoCapacity / param_capacity_mod];
        power:                          Bombardier_BSeries_Power;
		weight:                        	Bombardier_BSeries_Weight;
		running_cost_factor:            Bombardier_BSeries_RunningCostFactor;
}
}

