		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              X2000_IntroDate;		
		length:                         8;
		
		loading_speed:					SD_Intercity_LoadingSpeed;
		speed:							X2000_Speed km/h;
		cost_factor:					(X2000_CostFactor * 2);
		running_cost_factor:			(X2000_RunningCostFactor * 2);
		cargo_capacity: 				X2000_CargoCapacity_Half;
