 0: spriteset_Comeng_Tangara_PantoDown;
 1: spriteset_Comeng_Tangara_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_Comeng_Tangara_Rw_railtype, tile_powers_railtype("OHLE_DC")) {
 0: spriteset_Comeng_Tangara_PantoDown_r;
 1: spriteset_Comeng_Tangara_PantoUp_r;
}

switch(FEAT_TRAINS, SELF, switch_Comeng_Tangara_BG_Fw_railtype, tile_powers_railtype("BG_RAIL_OHLE_DC")) {
