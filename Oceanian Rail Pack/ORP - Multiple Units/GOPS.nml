		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_WALKERS_SMU200);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Walkers_SMU200_IntroDate;		
		length:                         Walkers_SMU200_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Walkers_SMU200_Speed km/h;
		cost_factor:					(Walkers_SMU200_CostFactor * 2);
		running_cost_factor:			(Walkers_SMU200_RunningCostFactor * 2);
		cargo_capacity: 				(Walkers_SMU200_CargoCapacity / param_capacity_mod);
		power:							(Walkers_SMU200_Power * 2);
		weight:							Walkers_SMU200_Weight ton;

        variant_group: 					Item_Walkers_SMU200_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_Walkers_SMU200_Liv2_endcars;
        purchase: 						switch_Walkers_SMU200_Liv2_PurchaseStack;
        additional_text: 				string(STR_INFO_WALKERS_SMU200);
    }
    livery_override (Item_MU_Trailer){
        default:						switch_Walkers_SMU200_Liv2_midcars;
        length:							Walkers_SMU200_Length;
        cargo_capacity:                 [Walkers_SMU200_CargoCapacity / param_capacity_mod];
        power:                          Walkers_SMU200_Power;
		weight:                        	Walkers_SMU200_Weight;
		running_cost_factor:            Walkers_SMU200_RunningCostFactor;
}
}

//ID
const XTrapolis100_ID = 11600;
//introduction_date
const XTrapolis100_IntroDate = date(2002, 1, 1);
//speed
const XTrapolis100_Speed = 120;
//cost_factor
const XTrapolis100_CostFactor = 25;
//running_cost_factor
const XTrapolis100_RunningCostFactor = 65;
//Cargo Capacity
const XTrapolis100_CargoCapacity = 121;
//power
const XTrapolis100_Power = 645; //MU power is for 1 vehicle
//weight
const XTrapolis100_Weight = 40;

//Pantographs
spriteset(spriteset_XTrapolis100_Panto_Purchase,   "gfx/XTrapolis100_Pantographs.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_XTrapolis100_PantoDown,   "gfx/XTrapolis100_Pantographs.png") {template_8(7, 39)}
spriteset(spriteset_XTrapolis100_PantoDown_r,   "gfx/XTrapolis100_Pantographs.png") {template_8_r(7, 39)}
spriteset(spriteset_XTrapolis100_PantoUp,   "gfx/XTrapolis100_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_XTrapolis100_PantoUp_r,   "gfx/XTrapolis100_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_XTrapolis100_Fw_railtype, tile_powers_railtype("BG_RAIL_OHLE_DC")) {
 0: spriteset_XTrapolis100_PantoDown;
 1: spriteset_XTrapolis100_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_XTrapolis100_Rw_railtype, tile_powers_railtype("BG_RAIL_OHLE_DC")) {
 0: spriteset_XTrapolis100_PantoDown_r; //might need switching back to just panto down
 1: spriteset_XTrapolis100_PantoUp_r;
}

//XTrapolis100_Liv0
spriteset(spriteset_XTrapolis100_Liv0_purchase,   "gfx/XTrapolis100_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_XTrapolis100_Liv0_lead,   "gfx/XTrapolis100_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_XTrapolis100_Liv0_lead_r,   "gfx/XTrapolis100_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_XTrapolis100_Liv0_Trailer,   "gfx/XTrapolis100_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_XTrapolis100_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_XTrapolis100_Liv0_purchase;
	1: spriteset_XTrapolis100_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_XTrapolis100_Liv0_LeadStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_XTrapolis100_Liv0_lead;
	1: switch_XTrapolis100_Fw_railtype;
}

//Pantograph cars
//Swap normal & _r cars to swap pantograph arrangements
switch (FEAT_TRAINS, SELF, switch_XTrapolis100_Liv0_PantoCarStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_XTrapolis100_Liv0_Trailer;
	1: switch_XTrapolis100_Fw_railtype;
}

switch (FEAT_TRAINS, SELF, switch_XTrapolis100_Liv0_PantoCarStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_XTrapolis100_Liv0_Trailer;
	1: switch_XTrapolis100_Rw_railtype;
}

/* Midcars */
        // Penultipantos
        switch (FEAT_TRAINS, SELF, switch_XTrapolis100_Liv0_pantos_large_forwards, position_in_vehid_chain ) {                
                0:  switch_XTrapolis100_Liv0_PantoCarStack;
                switch_XTrapolis100_Liv0_PantoCarStack_r;          
            }
        switch (FEAT_TRAINS, SELF, switch_XTrapolis100_Liv0_forwards_length_large, (position_in_vehid_chain == 0) || (position_in_vehid_chain_from_end == 0 )) {                
                1:  switch_XTrapolis100_Liv0_pantos_large_forwards;
                spriteset_XTrapolis100_Liv0_Trailer;        
            }
        // Panto in Middle
        switch (FEAT_TRAINS, SELF, switch_XTrapolis100_Liv0_forwards_length_small, (position_in_vehid_chain == position_in_vehid_chain_from_end ) || (position_in_vehid_chain - 1 == position_in_vehid_chain_from_end) ) {                
                0:  spriteset_XTrapolis100_Liv0_Trailer;
                switch_XTrapolis100_Liv0_PantoCarStack;                
            }
    switch (FEAT_TRAINS, SELF, switch_XTrapolis100_Liv0_midcars, num_vehs_in_vehid_chain) {
            0..1: switch_XTrapolis100_Liv0_forwards_length_large;
            2:  switch_XTrapolis100_Liv0_forwards_length_small;
            switch_XTrapolis100_Liv0_forwards_length_large;
        }

//End Car Controls
switch(FEAT_TRAINS, SELF, switch_XTrapolis100_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : spriteset_XTrapolis100_Liv0_lead;        //Not flipped, give Panto
    return switch_XTrapolis100_Liv0_LeadStack;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, switch_XTrapolis100_Liv0_endcars, position_in_vehid_chain){
    0: spriteset_XTrapolis100_Liv0_lead; //We need a pantograph, guaranteed
    return switch_XTrapolis100_Liv0_panto_flipcheck; //More Checks
}

const XTrapolis100_ID_Liv0 = (XTrapolis100_ID + Liv0_ID);

item(FEAT_TRAINS, Item_XTrapolis100_Liv0, XTrapolis100_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_TILT,TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     BG_RAIL_OHLE_DC;
