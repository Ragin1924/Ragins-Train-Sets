        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Walkers_ASeries_IntroDate;		
		length:                         Walkers_ASeries_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Walkers_ASeries_Speed km/h;
		cost_factor:					(Walkers_ASeries_CostFactor * 2);
		running_cost_factor:			(Walkers_ASeries_RunningCostFactor * 2);
		cargo_capacity: 				(Walkers_ASeries_CargoCapacity / param_capacity_mod);
		power:							(Walkers_ASeries_Power * 2);
		weight:							Walkers_ASeries_Weight ton;

//        variant_group: 					Item_Walkers_ASeries_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_Walkers_ASeries_Liv0_endcars;
        purchase: 						switch_Walkers_ASeries_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_WALKERS_ASERIES);
    }
    livery_override (Item_MU_Trailer){
        default:						switch_Walkers_ASeries_Liv0_midcars;
        length:							Walkers_ASeries_Length;
        cargo_capacity:                 [Walkers_ASeries_CargoCapacity / param_capacity_mod];
        power:                          Walkers_ASeries_Power;
		weight:                        	Walkers_ASeries_Weight;
		running_cost_factor:            Walkers_ASeries_RunningCostFactor;
}
}

//ID
const Walkers_SMU200_ID = 11560;
//introduction_date
const Walkers_SMU200_IntroDate = date(1994, 1, 1);
//speed
const Walkers_SMU200_Speed = 100;
//cost_factor
const Walkers_SMU200_CostFactor = 25;
//running_cost_factor
const Walkers_SMU200_RunningCostFactor = 64;
//Cargo Capacity
const Walkers_SMU200_CargoCapacity = 118;
//power
const Walkers_SMU200_Power = 643;
//weight
const Walkers_SMU200_Weight = 42;
//length
const Walkers_SMU200_Length = 8;

//Pantographs
spriteset(spriteset_Walkers_SMU200_Panto_Purchase,   "gfx/Walkers_SMU200_Pantographs.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Walkers_SMU200_PantoDown,   "gfx/Walkers_SMU200_Pantographs.png") {template_8(7, 39)}
spriteset(spriteset_Walkers_SMU200_PantoDown_r,   "gfx/Walkers_SMU200_Pantographs.png") {template_8_r(7, 39)}
spriteset(spriteset_Walkers_SMU200_PantoUp,   "gfx/Walkers_SMU200_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_Walkers_SMU200_PantoUp_r,   "gfx/Walkers_SMU200_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_Walkers_SMU200_Fw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_Walkers_SMU200_PantoDown;
 1: spriteset_Walkers_SMU200_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_Walkers_SMU200_Rw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_Walkers_SMU200_PantoDown_r; //might need switching back to just panto down
 1: spriteset_Walkers_SMU200_PantoUp_r;
}

//Walkers_SMU200_Liv0
spriteset(spriteset_Walkers_SMU200_Liv0_purchase,   "gfx/Walkers_SMU200_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Walkers_SMU200_Liv0_lead,   "gfx/Walkers_SMU200_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_Walkers_SMU200_Liv0_lead_r,   "gfx/Walkers_SMU200_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_Walkers_SMU200_Liv0_Trailer,   "gfx/Walkers_SMU200_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_Walkers_SMU200_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Walkers_SMU200_Liv0_purchase;
	1: spriteset_Walkers_SMU200_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_Walkers_SMU200_Liv0_LeadStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Walkers_SMU200_Liv0_lead;
	1: switch_Walkers_SMU200_Fw_railtype;
}

//Pantograph cars
//Swap normal & _r cars to swap pantograph arrangements
switch (FEAT_TRAINS, SELF, switch_Walkers_SMU200_Liv0_PantoCarStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Walkers_SMU200_Liv0_Trailer;
	1: switch_Walkers_SMU200_Fw_railtype;
}

switch (FEAT_TRAINS, SELF, switch_Walkers_SMU200_Liv0_PantoCarStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Walkers_SMU200_Liv0_Trailer;
	1: switch_Walkers_SMU200_Rw_railtype;
}

/* Midcars */
        // Penultipantos
        switch (FEAT_TRAINS, SELF, switch_Walkers_SMU200_Liv0_pantos_large_forwards, position_in_vehid_chain ) {                
                0:  switch_Walkers_SMU200_Liv0_PantoCarStack;
                switch_Walkers_SMU200_Liv0_PantoCarStack_r;          
            }
        switch (FEAT_TRAINS, SELF, switch_Walkers_SMU200_Liv0_forwards_length_large, (position_in_vehid_chain == 0) || (position_in_vehid_chain_from_end == 0 )) {                
                1:  switch_Walkers_SMU200_Liv0_pantos_large_forwards;
                spriteset_Walkers_SMU200_Liv0_Trailer;        
            }
        // Panto in Middle
        switch (FEAT_TRAINS, SELF, switch_Walkers_SMU200_Liv0_forwards_length_small, (position_in_vehid_chain == position_in_vehid_chain_from_end ) || (position_in_vehid_chain - 1 == position_in_vehid_chain_from_end) ) {                
                0:  spriteset_Walkers_SMU200_Liv0_Trailer;
                switch_Walkers_SMU200_Liv0_PantoCarStack;                
            }
    switch (FEAT_TRAINS, SELF, switch_Walkers_SMU200_Liv0_midcars, num_vehs_in_vehid_chain) {
            0..1: switch_Walkers_SMU200_Liv0_forwards_length_large;
            2:  switch_Walkers_SMU200_Liv0_forwards_length_small;
            switch_Walkers_SMU200_Liv0_forwards_length_large;
        }

//End Car Controls
switch(FEAT_TRAINS, SELF, switch_Walkers_SMU200_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : spriteset_Walkers_SMU200_Liv0_lead;        //Not flipped, give Panto
    return switch_Walkers_SMU200_Liv0_LeadStack;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, switch_Walkers_SMU200_Liv0_endcars, position_in_vehid_chain){
    0: spriteset_Walkers_SMU200_Liv0_lead; //We need a pantograph, guaranteed
    return switch_Walkers_SMU200_Liv0_panto_flipcheck; //More Checks
}

const Walkers_SMU200_ID_Liv0 = (Walkers_SMU200_ID + Liv0_ID);

item(FEAT_TRAINS, Item_Walkers_SMU200_Liv0, Walkers_SMU200_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_TILT,TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     NG_RAIL_OHLE_AC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_WALKERS_SMU200);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Walkers_SMU200_IntroDate;		
		length:                         Walkers_SMU200_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Walkers_SMU200_Speed km/h;
		cost_factor:					(Walkers_SMU200_CostFactor * 2);
		running_cost_factor:			(Walkers_SMU200_RunningCostFactor * 2);
		cargo_capacity: 				(Walkers_SMU200_CargoCapacity / param_capacity_mod);
		power:							(Walkers_SMU200_Power * 2);
		weight:							Walkers_SMU200_Weight ton;

//        variant_group: 					Item_Walkers_SMU200_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_Walkers_SMU200_Liv0_endcars;
        purchase: 						switch_Walkers_SMU200_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_WALKERS_SMU200);
    }
    livery_override (Item_MU_Trailer){
        default:						switch_Walkers_SMU200_Liv0_midcars;
        length:							Walkers_SMU200_Length;
        cargo_capacity:                 [Walkers_SMU200_CargoCapacity / param_capacity_mod];
        power:                          Walkers_SMU200_Power;
		weight:                        	Walkers_SMU200_Weight;
		running_cost_factor:            Walkers_SMU200_RunningCostFactor;
}
}

