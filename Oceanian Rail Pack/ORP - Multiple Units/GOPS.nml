		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_HARRIS);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Harris_IntroDate;		
		length:                         8;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Harris_Speed km/h;
		cost_factor:					(Harris_CostFactor * 2);
		running_cost_factor:			(Harris_RunningCostFactor * 2);
		cargo_capacity: 				(Harris_CargoCapacity / param_capacity_mod);
		power:							(Harris_Power * 2);
		weight:							Harris_Weight ton;

//        variant_group: 					Item_Harris_MU_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Harris_Liv0_frontcheck;
        purchase: 						switch_Harris_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_HARRIS);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_Harris_Liv0_lencheck ;
        length:							8;
        cargo_capacity:                 [Harris_CargoCapacity / param_capacity_mod];
        power:                          Harris_Power;
		weight:                        	Harris_Weight;
		running_cost_factor:            Harris_RunningCostFactor;

    }
}

//ID
const SputnikSuburbanEMU_ID = 11240;
//introduction_date
const SputnikSuburbanEMU_IntroDate = date(1957, 1, 1);
//speed
const SputnikSuburbanEMU_Speed = 115;
//cost_factor
const SputnikSuburbanEMU_CostFactor = 22;
//running_cost_factor
const SputnikSuburbanEMU_RunningCostFactor = 56;
//Cargo Capacity
const SputnikSuburbanEMU_CargoCapacity = 104;
//power
const SputnikSuburbanEMU_Power = 360; //MU power is for 2 individual vehicles
//weight
const SputnikSuburbanEMU_Weight = 48;

//Pantographs
spriteset(spriteset_SputnikSuburbanEMU_Panto_Purchase,   "gfx/SputnikSuburbanEMU_Pantographs.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_SputnikSuburbanEMU_PantoDown,   "gfx/SputnikSuburbanEMU_Pantographs.png") {template_8(7, 39)}
spriteset(spriteset_SputnikSuburbanEMU_PantoDown_r,   "gfx/SputnikSuburbanEMU_Pantographs.png") {template_8_r(7, 39)}
spriteset(spriteset_SputnikSuburbanEMU_PantoUp,   "gfx/SputnikSuburbanEMU_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_SputnikSuburbanEMU_PantoUp_r,   "gfx/SputnikSuburbanEMU_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_SputnikSuburbanEMU_Fw_railtype, tile_powers_railtype("OHLE_DC")) {
 0: spriteset_SputnikSuburbanEMU_PantoDown;
 1: spriteset_SputnikSuburbanEMU_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_SputnikSuburbanEMU_Rw_railtype, tile_powers_railtype("OHLE_DC")) {
 0: spriteset_SputnikSuburbanEMU_PantoDown_r; //might need switching back to just panto down
 1: spriteset_SputnikSuburbanEMU_PantoUp_r;
}

//SputnikSuburbanEMU_Liv0
spriteset(spriteset_SputnikSuburbanEMU_Liv0_purchase,   "gfx/SputnikSuburbanEMU_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_SputnikSuburbanEMU_Liv0_lead,   "gfx/SputnikSuburbanEMU_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_SputnikSuburbanEMU_Liv0_lead_r,   "gfx/SputnikSuburbanEMU_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_SputnikSuburbanEMU_Liv0_Trailer,   "gfx/SputnikSuburbanEMU_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_SputnikSuburbanEMU_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_SputnikSuburbanEMU_Liv0_purchase;
	1: spriteset_SputnikSuburbanEMU_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_SputnikSuburbanEMU_Liv0_MotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_SputnikSuburbanEMU_Liv0_lead;
	1: switch_SputnikSuburbanEMU_Fw_railtype;
}
//C Rear
switch (FEAT_TRAINS, SELF, switch_SputnikSuburbanEMU_Liv0_MotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_SputnikSuburbanEMU_Liv0_lead;
	1: switch_SputnikSuburbanEMU_Fw_railtype;
}

//N Lead
switch (FEAT_TRAINS, SELF, switch_SputnikSuburbanEMU_Liv0_NonControlMotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_SputnikSuburbanEMU_Liv0_lead;
	1: switch_SputnikSuburbanEMU_Fw_railtype;
}
//N Rear
switch (FEAT_TRAINS, SELF, switch_SputnikSuburbanEMU_Liv0_NonControlMotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_SputnikSuburbanEMU_Liv0_lead_r;
	1: switch_SputnikSuburbanEMU_Rw_railtype;
}

//Forward
switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_pantocheck_at_2, position_in_vehid_chain % 3){
    2 : switch_SputnikSuburbanEMU_Liv0_NonControlMotorStack_r;
    return spriteset_SputnikSuburbanEMU_Liv0_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_pantocheck_at_2r, position_in_vehid_chain_from_end % 3){
    2 : switch_SputnikSuburbanEMU_Liv0_NonControlMotorStack;
    return spriteset_SputnikSuburbanEMU_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_pantocheck_at_1, position_in_vehid_chain % 2){
    1 : switch_SputnikSuburbanEMU_Liv0_NonControlMotorStack_r;
    return spriteset_SputnikSuburbanEMU_Liv0_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_pantocheck_at_1r, position_in_vehid_chain_from_end % 2){
    1 : switch_SputnikSuburbanEMU_Liv0_NonControlMotorStack;
    return spriteset_SputnikSuburbanEMU_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_sidecheck_other, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_SputnikSuburbanEMU_Liv0_pantocheck_at_1;
    return sw_SputnikSuburbanEMU_Liv0_pantocheck_at_1r;
}

switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_sidecheck_4, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_SputnikSuburbanEMU_Liv0_pantocheck_at_1;
    return spriteset_SputnikSuburbanEMU_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_sidecheck_6, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_SputnikSuburbanEMU_Liv0_pantocheck_at_2;
    return sw_SputnikSuburbanEMU_Liv0_pantocheck_at_2r;
}

switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_lencheck, num_vehs_in_vehid_chain ) {
    0 .. 2 : spriteset_SputnikSuburbanEMU_Liv0_Trailer;
    3 : sw_SputnikSuburbanEMU_Liv0_pantocheck_at_1;
    4 : sw_SputnikSuburbanEMU_Liv0_sidecheck_4;
    5 : sw_SputnikSuburbanEMU_Liv0_pantocheck_at_2;
    6 .. 7 : sw_SputnikSuburbanEMU_Liv0_sidecheck_6;
    return sw_SputnikSuburbanEMU_Liv0_sidecheck_other;
}

//endcars
switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_panto_direction, vehicle_is_flipped){
    0 : switch_SputnikSuburbanEMU_Liv0_MotorStack;        //Front panto
    return switch_SputnikSuburbanEMU_Liv0_MotorStack_r;    //Rear panto
}

switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : sw_SputnikSuburbanEMU_Liv0_panto_direction;        //Not flipped, give Panto
    return spriteset_SputnikSuburbanEMU_Liv0_lead;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, sw_SputnikSuburbanEMU_Liv0_frontcheck, position_in_vehid_chain){
    0: sw_SputnikSuburbanEMU_Liv0_panto_direction; //We need a pantograph, guaranteed
    return sw_SputnikSuburbanEMU_Liv0_panto_flipcheck; //More Checks
}

const SputnikSuburbanEMU_ID_Liv0 = (SputnikSuburbanEMU_ID + Liv0_ID);

item(FEAT_TRAINS, Item_SputnikSuburbanEMU_Liv0, SputnikSuburbanEMU_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_SPUTNIKSUBURBANEMU);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              SputnikSuburbanEMU_IntroDate;		
		length:                         8;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							SputnikSuburbanEMU_Speed km/h;
		cost_factor:					(SputnikSuburbanEMU_CostFactor * 2);
		running_cost_factor:			(SputnikSuburbanEMU_RunningCostFactor * 2);
		cargo_capacity: 				(SputnikSuburbanEMU_CargoCapacity / param_capacity_mod);
		power:							(SputnikSuburbanEMU_Power * 2);
		weight:							SputnikSuburbanEMU_Weight ton;

//        variant_group: 					Item_SputnikSuburbanEMU_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_SputnikSuburbanEMU_Liv0_frontcheck;
        purchase: 						switch_SputnikSuburbanEMU_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_SPUTNIKSUBURBANEMU);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_SputnikSuburbanEMU_Liv0_lencheck ;
        length:							8;
        cargo_capacity:                 [SputnikSuburbanEMU_CargoCapacity / param_capacity_mod];
        power:                          SputnikSuburbanEMU_Power;
		weight:                        	SputnikSuburbanEMU_Weight;
		running_cost_factor:            SputnikSuburbanEMU_RunningCostFactor;

    }
}

