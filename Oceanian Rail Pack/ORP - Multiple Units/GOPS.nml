    3 : spriteset_Tait_Roof1_Trailer;
	1 : spriteset_Tait_Roof2_Trailer;
}

switch(FEAT_TRAINS, PARENT, switch_Tait_Roof_Transition_Trailer, date_of_last_service) {
    0..date(1928, 12, 31): spriteset_Tait_Roof1_Trailer;
	date(1929, 1, 1)..date(2100, 1, 1): switch_Tait_Roof_Transition_Trailer_Random;
  return switch_Tait_Roof_Transition_Trailer_Random;
}

//Single Unit Purchase
switch(FEAT_TRAINS, PARENT, switch_Tait_Roof_Transition_Single_Purchase, date_of_last_service) {
    0..date(1928, 12, 31): spriteset_Tait_Roof1_Single_Purchase;
	date(1929, 1, 1)..date(2100, 1, 1): spriteset_Tait_Roof2_Single_Purchase;
  return spriteset_Tait_Roof2_Single_Purchase;
}

//Single Unit
random_switch(FEAT_TRAINS, SELF, switch_Tait_Roof_Transition_Single_Random){
    3 : spriteset_Tait_Roof1_Motor;
	1 : spriteset_Tait_Roof2_Motor;
}

switch(FEAT_TRAINS, PARENT, switch_Tait_Roof_Transition_Single, date_of_last_service) {
    0..date(1928, 12, 31): spriteset_Tait_Roof1_Motor;
