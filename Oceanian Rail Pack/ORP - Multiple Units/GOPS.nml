spriteset(spriteset_Bombardier_BSeries_PantoDown_r,   "gfx/Bombardier_BSeries_Pantographs.png") {template_8_r(7, 39)}
spriteset(spriteset_Bombardier_BSeries_PantoUp,   "gfx/Bombardier_BSeries_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_Bombardier_BSeries_PantoUp_r,   "gfx/Bombardier_BSeries_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_Bombardier_BSeries_Fw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_Bombardier_BSeries_PantoDown;
 1: spriteset_Bombardier_BSeries_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_Bombardier_BSeries_Rw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_Bombardier_BSeries_PantoDown_r; //might need switching back to just panto down
 1: spriteset_Bombardier_BSeries_PantoUp_r;
}

//Bombardier_BSeries_Liv0
spriteset(spriteset_Bombardier_BSeries_Liv0_purchase,   "gfx/Bombardier_BSeries_Liv0.png") {template_purchase_88mu(7, 21)}
