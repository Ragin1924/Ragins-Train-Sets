//Purchase timeline
switch(FEAT_TRAINS, PARENT, switch_Comeng_SSet_Liv3_Timeline_Purchase, current_year) {
    0..1973: spriteset_Comeng_SSet_Liv3_purchase_S1;
	1974..2100: spriteset_Comeng_SSet_Liv3_purchase_S2;
