    return switch_Hyundai_Mariyung_Liv0_MotorStack_r;    //Rear panto
}

switch(FEAT_TRAINS, SELF, sw_Hyundai_Mariyung_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : sw_Hyundai_Mariyung_Liv0_panto_direction;        //Not flipped, give Panto
    return spriteset_Hyundai_Mariyung_Liv0_lead;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, sw_Hyundai_Mariyung_Liv0_frontcheck, position_in_vehid_chain){
    0: sw_Hyundai_Mariyung_Liv0_panto_direction; //We need a pantograph, guaranteed
    return sw_Hyundai_Mariyung_Liv0_panto_flipcheck; //More Checks
}

const Hyundai_Mariyung_ID_Liv0 = (Hyundai_Mariyung_ID + Liv0_ID);

item(FEAT_TRAINS, Item_Hyundai_Mariyung_Liv0, Hyundai_Mariyung_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_HYUNDAI_MARIYUNG);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Hyundai_Mariyung_IntroDate;		
		length:                         Hyundai_Mariyung_Length;
		
		loading_speed:					DD_Intercity_LoadingSpeed;
		speed:							Hyundai_Mariyung_Speed km/h;
		cost_factor:					(Hyundai_Mariyung_CostFactor * 2);
		running_cost_factor:			(Hyundai_Mariyung_RunningCostFactor * 2);
		cargo_capacity: 				(Hyundai_Mariyung_CargoCapacity / param_capacity_mod);
		power:							(Hyundai_Mariyung_Power * 2);
		weight:							Hyundai_Mariyung_Weight ton;

//        variant_group: 					Item_Hyundai_Mariyung_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Hyundai_Mariyung_Liv0_frontcheck;
        purchase: 						switch_Hyundai_Mariyung_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_HYUNDAI_MARIYUNG);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_Hyundai_Mariyung_Liv0_lencheck ;
        length:							Hyundai_Mariyung_Length;
        cargo_capacity:                 [Hyundai_Mariyung_CargoCapacity / param_capacity_mod];
        power:                          Hyundai_Mariyung_Power;
		weight:                        	Hyundai_Mariyung_Weight;
		running_cost_factor:            Hyundai_Mariyung_RunningCostFactor;
}
}

//ID
const Comeng_XPTE_ID = 15020;
//introduction_date
const Comeng_XPTE_IntroDate = date(1983, 1, 1);
//speed
const Comeng_XPTE_Speed = 200;
//cost_factor
const Comeng_XPTE_CostFactor = 39;
//running_cost_factor
const Comeng_XPTE_RunningCostFactor = 98;
//Cargo Capacity
const Comeng_XPTE_CargoCapacity = 75;
//power
const Comeng_XPTE_Power_DC = 4800;
const Comeng_XPTE_Power_AC = 6000;
//weight
const Comeng_XPTE_Weight = 76;
const Comeng_XPTE_Weight_T = 26;
//length
const Comeng_XPTE_Length = 7;
const Comeng_XPTE_Length_T = 8;

//Change power output based on rail type
switch (FEAT_TRAINS, SELF, switch_Comeng_XPTE_power_1, tile_powers_railtype("OHLE_DC")) {
            1: return Comeng_XPTE_Power_DC;
        }
        switch (FEAT_TRAINS, SELF, switch_Comeng_XPTE_power_0, tile_powers_railtype("OHLE_AC")) {
            1: return Comeng_XPTE_Power_AC;
                return switch_Comeng_XPTE_power_1;
        }

//Power Language File Switch
switch (FEAT_TRAINS, SELF, switch_Comeng_XPTE_buy_menu_additional_text, [
                STORE_TEMP(
                    string(STR_POWER_SOURCE_OHLE_DC)
                    | (Comeng_XPTE_Power_DC << 16),
                    0x100
                ),
                STORE_TEMP(
                    string(STR_POWER_SOURCE_OHLE_AC)
                    | (Comeng_XPTE_Power_AC << 16),
                    0x101
                ),
        ]) {
            return string(STR_BUY_MENU_ADDITIONAL_TEXT_WRAPPER_TWO_SUBSTR, string(STR_POWER_BY_POWER_SOURCE_TWO_SOURCES), string(STR_INFO_COMENG_XPTE));
        }

