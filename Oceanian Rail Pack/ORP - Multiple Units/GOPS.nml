switch(FEAT_TRAINS, SELF, switch_Comeng_ADK_Liv0_position, vehicle_is_flipped){
    0:	spriteset_Comeng_ADK_Liv0_lead;
    1: 	spriteset_Comeng_ADK_Liv0_DT_lead;
}

const Comeng_ADK_ID_Liv0 = (Comeng_ADK_ID + Liv0_ID );

item(FEAT_TRAINS, Item_Comeng_ADK_Liv0, Comeng_ADK_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     NG_RAIL;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_DIESEL;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_DIESEL;

        name:                           string(STR_NAME_COMENG_ADK);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Comeng_ADK_IntroDate;		
//		length:                         8;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Comeng_ADK_Speed km/h;
		cost_factor:					(Comeng_ADK_CostFactor * 2);
//		running_cost_factor:			(Comeng_ADK_RunningCostFactor * 2);
		cargo_capacity: 				(Comeng_ADK_CargoCapacity / param_capacity_mod);
		power:							Comeng_ADK_Power;
//		weight:							Comeng_ADK_Weight ton;

//        variant_group: 					Item_Comeng_ADK_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_Comeng_ADK_Liv0_position;
        purchase: 						spriteset_Comeng_ADK_Liv0_purchase;
        additional_text: 				string(STR_INFO_COMENG_ADK);
		length:							switch_Comeng_ADK_length;
		running_cost_factor:			switch_Comeng_ADK_RunningCostFactor;
		weight:							switch_Comeng_ADK_weight;
    }
    livery_override (Item_MU_Trailer){
        default: 						spriteset_Comeng_ADK_Liv0_Trailer ;
        length: 						Comeng_ADK_Length_T;
        cargo_capacity:                 (Comeng_ADK_CargoCapacity_T / param_capacity_mod);
        power:                          0;
		weight:                        	Comeng_ADK_Weight_T;
		running_cost_factor:            (Comeng_ADK_RunningCostFactor_T / 2); //maybe remove the divide?
}
}

//ID
const Comeng_2000ClassDMU_ID = 5940;
//introduction_date
const Comeng_2000ClassDMU_IntroDate = date(1979, 1, 1);
//speed
const Comeng_2000ClassDMU_Speed = 120;
//cost_factor
const Comeng_2000ClassDMU_CostFactor = 26;
//running_cost_factor
const Comeng_2000ClassDMU_RunningCostFactor = 65;
//Cargo Capacity
const Comeng_2000ClassDMU_CargoCapacity = 112;
//power
const Comeng_2000ClassDMU_Power = 1012;
//weight
const Comeng_2000ClassDMU_Weight = 53;
//length
const Comeng_2000ClassDMU_Length = 8;

//Comeng_2000ClassDMU_Liv0
spriteset(spriteset_Comeng_2000ClassDMU_Liv0_purchase,   "gfx/Comeng_2000ClassDMU_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Comeng_2000ClassDMU_Liv0_lead,   "gfx/Comeng_2000ClassDMU_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_Comeng_2000ClassDMU_Liv0_lead_r,   "gfx/Comeng_2000ClassDMU_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_Comeng_2000ClassDMU_Liv0_DT,   "gfx/Comeng_2000ClassDMU_Liv0.png") {template_8(7, 69)}
spriteset(spriteset_Comeng_2000ClassDMU_Liv0_Trailer,   "gfx/Comeng_2000ClassDMU_Liv0.png") {template_8_repeat(7, 99)}

/* Midcars */
        // Penultipantos
		switch (FEAT_TRAINS, SELF, switch_Comeng_2000ClassDMU_Liv0_pantos_MiddlePantos, position_in_vehid_chain % 4 ) {                
                0: spriteset_Comeng_2000ClassDMU_Liv0_lead;
				1: spriteset_Comeng_2000ClassDMU_Liv0_Trailer;
				2: spriteset_Comeng_2000ClassDMU_Liv0_lead_r;
				3: spriteset_Comeng_2000ClassDMU_Liv0_Trailer;
				spriteset_Comeng_2000ClassDMU_Liv0_Trailer;
            }
		
        switch (FEAT_TRAINS, SELF, switch_Comeng_2000ClassDMU_Liv0_pantos_large_forwards, position_in_vehid_chain ) {                
                0:  spriteset_Comeng_2000ClassDMU_Liv0_lead;
                spriteset_Comeng_2000ClassDMU_Liv0_lead_r;          
            }
        switch (FEAT_TRAINS, SELF, switch_Comeng_2000ClassDMU_Liv0_forwards_length_large, (position_in_vehid_chain == 0) || (position_in_vehid_chain_from_end == 0 )) {                
                1:  switch_Comeng_2000ClassDMU_Liv0_pantos_large_forwards;
                switch_Comeng_2000ClassDMU_Liv0_pantos_MiddlePantos;        
            }
        // Panto in Middle
        switch (FEAT_TRAINS, SELF, switch_Comeng_2000ClassDMU_Liv0_forwards_length_small, (position_in_vehid_chain == position_in_vehid_chain_from_end ) || (position_in_vehid_chain - 1 == position_in_vehid_chain_from_end) ) {                
                0:  spriteset_Comeng_2000ClassDMU_Liv0_lead;
                spriteset_Comeng_2000ClassDMU_Liv0_lead_r;                
            }
    switch (FEAT_TRAINS, SELF, switch_Comeng_2000ClassDMU_Liv0_forwards_length, num_vehs_in_vehid_chain) {
            0..1: switch_Comeng_2000ClassDMU_Liv0_forwards_length_large;
            2:  switch_Comeng_2000ClassDMU_Liv0_forwards_length_small;
            switch_Comeng_2000ClassDMU_Liv0_forwards_length_large;
        }

//End Car Controls
switch(FEAT_TRAINS, SELF, switch_Comeng_2000ClassDMU_Liv0_flipcheck, vehicle_is_flipped){
    0 : spriteset_Comeng_2000ClassDMU_Liv0_DT;
    return spriteset_Comeng_2000ClassDMU_Liv0_lead;
}

switch(FEAT_TRAINS, SELF, switch_Comeng_2000ClassDMU_Liv0_frontcheck, position_in_vehid_chain){
    0: spriteset_Comeng_2000ClassDMU_Liv0_DT;
    return switch_Comeng_2000ClassDMU_Liv0_flipcheck;
}

