//ID
const Walkers_ASeries_ID = 11540;
//introduction_date
const Walkers_ASeries_IntroDate = date(1991, 1, 1);
//speed
const Walkers_ASeries_Speed = 120;
//cost_factor
const Walkers_ASeries_CostFactor = 24;
//running_cost_factor
const Walkers_ASeries_RunningCostFactor = 63;
//Cargo Capacity
const Walkers_ASeries_CargoCapacity = 116;
//power
const Walkers_ASeries_Power = 784;
//weight
const Walkers_ASeries_Weight = 47;
//length
const Walkers_ASeries_Length = 8;

//Pantographs
spriteset(spriteset_Walkers_ASeries_Panto_Purchase,   "gfx/Walkers_ASeries_Pantographs.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Walkers_ASeries_PantoDown,   "gfx/Walkers_ASeries_Pantographs.png") {template_8(7, 39)}
spriteset(spriteset_Walkers_ASeries_PantoDown_r,   "gfx/Walkers_ASeries_Pantographs.png") {template_8_r(7, 39)}
spriteset(spriteset_Walkers_ASeries_PantoUp,   "gfx/Walkers_ASeries_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_Walkers_ASeries_PantoUp_r,   "gfx/Walkers_ASeries_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_Walkers_ASeries_Fw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_Walkers_ASeries_PantoDown;
 1: spriteset_Walkers_ASeries_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_Walkers_ASeries_Rw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_Walkers_ASeries_PantoDown_r; //might need switching back to just panto down
 1: spriteset_Walkers_ASeries_PantoUp_r;
}

//Walkers_ASeries_Liv0
spriteset(spriteset_Walkers_ASeries_Liv0_purchase,   "gfx/Walkers_ASeries_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Walkers_ASeries_Liv0_lead,   "gfx/Walkers_ASeries_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_Walkers_ASeries_Liv0_lead_r,   "gfx/Walkers_ASeries_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_Walkers_ASeries_Liv0_Trailer,   "gfx/Walkers_ASeries_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_Walkers_ASeries_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Walkers_ASeries_Liv0_purchase;
	1: spriteset_Walkers_ASeries_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_Walkers_ASeries_Liv0_LeadStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Walkers_ASeries_Liv0_lead;
	1: switch_Walkers_ASeries_Fw_railtype;
}

//Pantograph cars
//Swap normal & _r cars to swap pantograph arrangements
switch (FEAT_TRAINS, SELF, switch_Walkers_ASeries_Liv0_PantoCarStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Walkers_ASeries_Liv0_Trailer;
	1: switch_Walkers_ASeries_Fw_railtype;
}

switch (FEAT_TRAINS, SELF, switch_Walkers_ASeries_Liv0_PantoCarStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Walkers_ASeries_Liv0_Trailer;
	1: switch_Walkers_ASeries_Rw_railtype;
}

/* Midcars */
        // Penultipantos
        switch (FEAT_TRAINS, SELF, switch_Walkers_ASeries_Liv0_pantos_large_forwards, position_in_vehid_chain ) {                
                0:  switch_Walkers_ASeries_Liv0_PantoCarStack;
                switch_Walkers_ASeries_Liv0_PantoCarStack_r;          
            }
        switch (FEAT_TRAINS, SELF, switch_Walkers_ASeries_Liv0_forwards_length_large, (position_in_vehid_chain == 0) || (position_in_vehid_chain_from_end == 0 )) {                
                1:  switch_Walkers_ASeries_Liv0_pantos_large_forwards;
                spriteset_Walkers_ASeries_Liv0_Trailer;        
            }
        // Panto in Middle
        switch (FEAT_TRAINS, SELF, switch_Walkers_ASeries_Liv0_forwards_length_small, (position_in_vehid_chain == position_in_vehid_chain_from_end ) || (position_in_vehid_chain - 1 == position_in_vehid_chain_from_end) ) {                
                0:  spriteset_Walkers_ASeries_Liv0_Trailer;
                switch_Walkers_ASeries_Liv0_PantoCarStack;                
            }
    switch (FEAT_TRAINS, SELF, switch_Walkers_ASeries_Liv0_midcars, num_vehs_in_vehid_chain) {
            0..1: switch_Walkers_ASeries_Liv0_forwards_length_large;
            2:  switch_Walkers_ASeries_Liv0_forwards_length_small;
            switch_Walkers_ASeries_Liv0_forwards_length_large;
        }

//End Car Controls
switch(FEAT_TRAINS, SELF, switch_Walkers_ASeries_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : spriteset_Walkers_ASeries_Liv0_lead;        //Not flipped, give Panto
    return switch_Walkers_ASeries_Liv0_LeadStack;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, switch_Walkers_ASeries_Liv0_endcars, position_in_vehid_chain){
    0: spriteset_Walkers_ASeries_Liv0_lead; //We need a pantograph, guaranteed
    return switch_Walkers_ASeries_Liv0_panto_flipcheck; //More Checks
}

