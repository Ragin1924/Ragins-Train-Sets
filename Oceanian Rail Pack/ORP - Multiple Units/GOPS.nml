//Midcars
switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_pantocheck_at_2, position_in_vehid_chain % 3){
    2 : switch_Comeng_Tangara_Liv0_NonControlMotorStack_r;
    return spriteset_Comeng_Tangara_Liv0_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_pantocheck_at_2r, position_in_vehid_chain_from_end % 3){
    2 : switch_Comeng_Tangara_Liv0_NonControlMotorStack;
    return spriteset_Comeng_Tangara_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_pantocheck_at_1, position_in_vehid_chain % 2){
    1 : switch_Comeng_Tangara_Liv0_NonControlMotorStack_r;
    return spriteset_Comeng_Tangara_Liv0_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_pantocheck_at_1r, position_in_vehid_chain_from_end % 2){
    1 : switch_Comeng_Tangara_Liv0_NonControlMotorStack;
    return spriteset_Comeng_Tangara_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_sidecheck_other, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Comeng_Tangara_Liv0_pantocheck_at_1;
    return sw_Comeng_Tangara_Liv0_pantocheck_at_1r;
}

switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_sidecheck_4, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Comeng_Tangara_Liv0_pantocheck_at_1;
    return spriteset_Comeng_Tangara_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_sidecheck_6, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Comeng_Tangara_Liv0_pantocheck_at_2;
    return sw_Comeng_Tangara_Liv0_pantocheck_at_2r;
}

switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_lencheck, num_vehs_in_vehid_chain ) {
    0 .. 2 : spriteset_Comeng_Tangara_Liv0_Trailer;
    3 : sw_Comeng_Tangara_Liv0_pantocheck_at_1;
    4 : sw_Comeng_Tangara_Liv0_sidecheck_4;
    5 : sw_Comeng_Tangara_Liv0_pantocheck_at_2;
    6 .. 7 : sw_Comeng_Tangara_Liv0_sidecheck_6;
    return sw_Comeng_Tangara_Liv0_sidecheck_other;
}

//Endcars
switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_panto_direction, vehicle_is_flipped){
    0 : switch_Comeng_Tangara_Liv0_MotorStack;        //Front panto
    return switch_Comeng_Tangara_Liv0_MotorStack_r;    //Rear panto
}

switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : sw_Comeng_Tangara_Liv0_panto_direction;        //Not flipped, give Panto
    return spriteset_Comeng_Tangara_Liv0_lead;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, sw_Comeng_Tangara_Liv0_frontcheck, position_in_vehid_chain){
    0: sw_Comeng_Tangara_Liv0_panto_direction; //We need a pantograph, guaranteed
    return sw_Comeng_Tangara_Liv0_panto_flipcheck; //More Checks
}

const Comeng_Tangara_ID_Liv0 = (Comeng_Tangara_ID + Liv0_ID);

item(FEAT_TRAINS, Item_Comeng_Tangara_Liv0, Comeng_Tangara_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_ProposalDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_COMENG_TANGARA);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Comeng_Tangara_IntroDate;		
		length:                         Comeng_Tangara_Length;
		
		loading_speed:					DD_Suburban_LoadingSpeed;
		speed:							Comeng_Tangara_Speed km/h;
		cost_factor:					(Comeng_Tangara_CostFactor * 2);
		running_cost_factor:			(Comeng_Tangara_RunningCostFactor * 2);
		cargo_capacity: 				(Comeng_Tangara_CargoCapacity / param_capacity_mod);
		power:							(Comeng_Tangara_Power * 2);
		weight:							Comeng_Tangara_Weight ton;

//        variant_group: 					Item_Comeng_Tangara_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Comeng_Tangara_Liv0_frontcheck;
        purchase: 						switch_Comeng_Tangara_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_COMENG_TANGARA);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_Comeng_Tangara_Liv0_lencheck ;
        length:							Comeng_Tangara_Length;
        cargo_capacity:                 [Comeng_Tangara_CargoCapacity / param_capacity_mod];
        power:                          Comeng_Tangara_Power;
		weight:                        	Comeng_Tangara_Weight;
		running_cost_factor:            Comeng_Tangara_RunningCostFactor;
}
}

