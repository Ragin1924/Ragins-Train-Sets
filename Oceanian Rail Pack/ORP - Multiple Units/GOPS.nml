//C Lead
switch (FEAT_TRAINS, SELF, switch_Hitachi_Liv0_MotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Hitachi_Liv0_Lead_Timeline;
	1: switch_Hitachi_Fw_railtype;
}
//C Rear
switch (FEAT_TRAINS, SELF, switch_Hitachi_Liv0_MotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Hitachi_Liv0_Lead_Timeline;
	1: switch_Hitachi_Fw_railtype;
}

//N Lead
switch (FEAT_TRAINS, SELF, switch_Hitachi_Liv0_NonControlMotorStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Hitachi_Liv0_Lead_Timeline;
	1: switch_Hitachi_Fw_railtype;
}
//N Rear
switch (FEAT_TRAINS, SELF, switch_Hitachi_Liv0_NonControlMotorStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: switch_Hitachi_Liv0_Lead_Timeline_r;
	1: switch_Hitachi_Rw_railtype;
}

//Midcars
switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_pantocheck_at_2, position_in_vehid_chain % 3){
    2 : switch_Hitachi_Liv0_NonControlMotorStack_r;
    return spriteset_Hitachi_Liv0_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_pantocheck_at_2r, position_in_vehid_chain_from_end % 3){
    2 : switch_Hitachi_Liv0_NonControlMotorStack;
    return spriteset_Hitachi_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_pantocheck_at_1, position_in_vehid_chain % 2){
    1 : switch_Hitachi_Liv0_NonControlMotorStack_r;
    return spriteset_Hitachi_Liv0_Trailer;
}
switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_pantocheck_at_1r, position_in_vehid_chain_from_end % 2){
    1 : switch_Hitachi_Liv0_NonControlMotorStack;
    return spriteset_Hitachi_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_sidecheck_other, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Hitachi_Liv0_pantocheck_at_1;
    return sw_Hitachi_Liv0_pantocheck_at_1r;
}

switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_sidecheck_4, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Hitachi_Liv0_pantocheck_at_1;
    return spriteset_Hitachi_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_sidecheck_6, num_vehs_in_vehid_chain/2 > position_in_vehid_chain ) {
    1 : sw_Hitachi_Liv0_pantocheck_at_2;
    return sw_Hitachi_Liv0_pantocheck_at_2r;
}

switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_lencheck, num_vehs_in_vehid_chain ) {
    0 .. 2 : spriteset_Hitachi_Liv0_Trailer;
    3 : sw_Hitachi_Liv0_pantocheck_at_1;
    4 : sw_Hitachi_Liv0_sidecheck_4;
    5 : sw_Hitachi_Liv0_pantocheck_at_2;
    6 .. 7 : sw_Hitachi_Liv0_sidecheck_6;
    return sw_Hitachi_Liv0_sidecheck_other;
}

//Endcars
switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_panto_direction, vehicle_is_flipped){
    0 : switch_Hitachi_Liv0_MotorStack;        //Front panto
    return switch_Hitachi_Liv0_MotorStack_r;    //Rear panto
}

switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : sw_Hitachi_Liv0_panto_direction;        //Not flipped, give Panto
    return switch_Hitachi_Liv0_Lead_Timeline;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, sw_Hitachi_Liv0_frontcheck, position_in_vehid_chain){
    0: sw_Hitachi_Liv0_panto_direction; //We need a pantograph, guaranteed
    return sw_Hitachi_Liv0_panto_flipcheck; //More Checks
}

const Hitachi_ID_Liv0 = (Hitachi_ID + Liv0_ID);

item(FEAT_TRAINS, Item_Hitachi_Liv0, Hitachi_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     BG_RAIL_OHLE_DC;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_HITACHI);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Hitachi_IntroDate;		
		length:                         8;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Hitachi_Speed km/h;
		cost_factor:					(Hitachi_CostFactor * 2);
		running_cost_factor:			(Hitachi_RunningCostFactor * 2);
		cargo_capacity: 				(Hitachi_CargoCapacity / param_capacity_mod);
		power:							(Hitachi_Power * 2);
		weight:							Hitachi_Weight ton;

//        variant_group: 					Item_Hitachi_MU_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						sw_Hitachi_Liv0_frontcheck;
        purchase: 						switch_Hitachi_Liv0_PurchaseStack;
        additional_text: 				string(STR_INFO_HITACHI);
    }
    livery_override (Item_MU_Trailer){
        default:						sw_Hitachi_Liv0_lencheck ;
        length:							8;
        cargo_capacity:                 [Hitachi_CargoCapacity / param_capacity_mod];
        power:                          Hitachi_Power;
		weight:                        	Hitachi_Weight;
		running_cost_factor:            Hitachi_RunningCostFactor;

    }
}

//ID
const AucklandART_ID = 11340;
//introduction_date
const AucklandART_IntroDate = date(1974, 1, 1);
//speed
const AucklandART_Speed = 115;
//cost_factor
const AucklandART_CostFactor = 23;
//running_cost_factor
const AucklandART_RunningCostFactor = 59;
//Cargo Capacity
const AucklandART_CargoCapacity = 110;
//power
const AucklandART_Power = 480; //MU power is for 2 individual vehicles
//weight
const AucklandART_Weight = 38;
//length
const AucklandART_Length = 8;

//Pantographs
spriteset(spriteset_AucklandART_Panto_Purchase,   "gfx/AucklandART_Pantographs.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_AucklandART_PantoDown,   "gfx/AucklandART_Pantographs.png") {template_8(7, 39)}
spriteset(spriteset_AucklandART_PantoDown_r,   "gfx/AucklandART_Pantographs.png") {template_8_r(7, 39)}
spriteset(spriteset_AucklandART_PantoUp,   "gfx/AucklandART_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_AucklandART_PantoUp_r,   "gfx/AucklandART_Pantographs.png") {template_8_r(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_AucklandART_Fw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_AucklandART_PantoDown;
 1: spriteset_AucklandART_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_AucklandART_Rw_railtype, tile_powers_railtype("NG_RAIL_OHLE_AC")) {
 0: spriteset_AucklandART_PantoDown_r; //might need switching back to just panto down
 1: spriteset_AucklandART_PantoUp_r;
}

//AucklandART_Liv0
spriteset(spriteset_AucklandART_Liv0_purchase,   "gfx/AucklandART_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_AucklandART_Liv0_lead,   "gfx/AucklandART_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_AucklandART_Liv0_lead_r,   "gfx/AucklandART_Liv0.png") {template_8_r(7, 39)}
spriteset(spriteset_AucklandART_Liv0_Trailer,   "gfx/AucklandART_Liv0.png") {template_8_repeat(7, 69)}

//Purchase Stack
switch (FEAT_TRAINS, SELF, switch_AucklandART_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_AucklandART_Liv0_purchase;
	1: spriteset_AucklandART_Panto_Purchase;
}

//C Lead
switch (FEAT_TRAINS, SELF, switch_AucklandART_Liv0_LeadStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_AucklandART_Liv0_lead;
	1: switch_AucklandART_Fw_railtype;
}

//Pantograph cars
//Swap normal & _r cars to swap pantograph arrangements
switch (FEAT_TRAINS, SELF, switch_AucklandART_Liv0_PantoCarStack_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_AucklandART_Liv0_Trailer;
	1: switch_AucklandART_Fw_railtype;
}

switch (FEAT_TRAINS, SELF, switch_AucklandART_Liv0_PantoCarStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_AucklandART_Liv0_Trailer;
	1: switch_AucklandART_Rw_railtype;
}

/* Midcars */
        // Penultipantos
        switch (FEAT_TRAINS, SELF, switch_AucklandART_Liv0_pantos_large_forwards, position_in_vehid_chain ) {                
                0:  switch_AucklandART_Liv0_PantoCarStack;
                switch_AucklandART_Liv0_PantoCarStack_r;          
            }
        switch (FEAT_TRAINS, SELF, switch_AucklandART_Liv0_forwards_length_large, (position_in_vehid_chain == 0) || (position_in_vehid_chain_from_end == 0 )) {                
                1:  switch_AucklandART_Liv0_pantos_large_forwards;
                spriteset_AucklandART_Liv0_Trailer;        
            }
        // Panto in Middle
        switch (FEAT_TRAINS, SELF, switch_AucklandART_Liv0_forwards_length_small, (position_in_vehid_chain == position_in_vehid_chain_from_end ) || (position_in_vehid_chain - 1 == position_in_vehid_chain_from_end) ) {                
                0:  spriteset_AucklandART_Liv0_Trailer;
                switch_AucklandART_Liv0_PantoCarStack;                
            }
    switch (FEAT_TRAINS, SELF, switch_AucklandART_Liv0_midcars, num_vehs_in_vehid_chain) {
            0..1: switch_AucklandART_Liv0_forwards_length_large;
            2:  switch_AucklandART_Liv0_forwards_length_small;
            switch_AucklandART_Liv0_forwards_length_large;
        }

//End Car Controls
switch(FEAT_TRAINS, SELF, switch_AucklandART_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : spriteset_AucklandART_Liv0_lead;        //Not flipped, give Panto
    return switch_AucklandART_Liv0_LeadStack;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, switch_AucklandART_Liv0_endcars, position_in_vehid_chain){
    0: spriteset_AucklandART_Liv0_lead; //We need a pantograph, guaranteed
    return switch_AucklandART_Liv0_panto_flipcheck; //More Checks
}

