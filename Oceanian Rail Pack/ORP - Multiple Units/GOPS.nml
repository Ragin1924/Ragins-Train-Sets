//power
const Comeng_ThaiXPT_Power = 4000;
//weight
const Comeng_ThaiXPT_Weight = 76;
const Comeng_ThaiXPT_Weight_T = 26;

//Comeng_ThaiXPT_Liv0
spriteset(spriteset_Comeng_ThaiXPT_Liv0_purchase,   "gfx/Comeng_ThaiXPT_Liv0.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Comeng_ThaiXPT_Liv0_lead,   "gfx/Comeng_ThaiXPT_Liv0.png") {template_8(7, 39)}

spriteset(spriteset_Comeng_ThaiXPT_Liv0_Trailer,   "gfx/Comeng_ThaiXPT_Liv0.png") {template_8_repeat(7, 99)}
spriteset(spriteset_Comeng_ThaiXPT_Liv0_Trailer_lead,   "gfx/Comeng_ThaiXPT_Liv0.png") {template_8_r(7, 69)}
spriteset(spriteset_Comeng_ThaiXPT_Liv0_Trailer_rear,   "gfx/Comeng_ThaiXPT_Liv0.png") {template_8(7, 69)}

//Trailers
switch(FEAT_TRAINS, SELF, switch_Comeng_ThaiXPT_Liv0_Trailer_Rear, position_in_vehid_chain_from_end){
    0:    spriteset_Comeng_ThaiXPT_Liv0_Trailer_rear;
    spriteset_Comeng_ThaiXPT_Liv0_Trailer;
}

switch(FEAT_TRAINS, SELF, switch_Comeng_ThaiXPT_Liv0_Trailer_Lead, position_in_vehid_chain){
    0:    spriteset_Comeng_ThaiXPT_Liv0_Trailer_lead;
    switch_Comeng_ThaiXPT_Liv0_Trailer_Rear;
}

switch(FEAT_TRAINS, SELF, switch_Comeng_ThaiXPT_Liv0_Trailer, num_vehs_in_vehid_chain){
    1:    spriteset_Comeng_ThaiXPT_Liv0_Trailer;
    switch_Comeng_ThaiXPT_Liv0_Trailer_Lead;
}

const Comeng_ThaiXPT_ID_Liv0 = (Comeng_ThaiXPT_ID + Liv0_ID );

item(FEAT_TRAINS, Item_Comeng_ThaiXPT_Liv0, Comeng_ThaiXPT_ID_Liv0) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
