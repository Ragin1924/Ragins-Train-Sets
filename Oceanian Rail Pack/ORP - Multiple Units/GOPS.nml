        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     RAIL;
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_DIESEL;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 3, DISABLE_WAGON_POWER);

        name:                           string(STR_NAME_COMENG_XPT);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Comeng_XPT_IntroDate;		
		length:                         7;
		
		loading_speed:					SD_Express_LoadingSpeed;
		speed:							Comeng_XPT_Speed km/h;
		cost_factor:					(Comeng_XPT_CostFactor * 2);
		running_cost_factor:			(Comeng_XPT_RunningCostFactor * 2);
		cargo_capacity: 				0;
		power:							Comeng_XPT_Power;
		weight:							Comeng_XPT_Weight ton;

        variant_group: 					Item_Comeng_XPT_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_Comeng_XPT_Liv5_PowerCar;
        purchase: 						spriteset_Comeng_XPT_Liv5_purchase;
        additional_text: 				string(STR_INFO_COMENG_XPT);
    }
    livery_override (Item_MU_Trailer){
        default: 						switch_Comeng_XPT_Liv5_Trailer ;
        length: 						8;
        cargo_capacity:                 (Comeng_XPT_CargoCapacity / param_capacity_mod);
        power:                          0;
		weight:                        	Comeng_XPT_Weight_T;
		running_cost_factor:            (Comeng_XPT_RunningCostFactor / 2); //maybe remove the divide?

    }
}

//ID
const Tait_ID = 11080;
//introduction_date
const Tait_IntroDate = date(1919, 1, 1);
//speed
const Tait_Speed = 80; //verify at a later date, 110 km/h seems rather high
//cost_factor
const Tait_CostFactor = 18;
//running_cost_factor
const Tait_RunningCostFactor = 47;
//Cargo Capacity
const Tait_CargoCapacity = 88;
//power
const Tait_Power = 282;
//weight
const Tait_Weight = 35;

//Pantographs
//Single
spriteset(spriteset_Tait_Panto_Single_Purchase,   "gfx/Tait_Pantographs.png") {template_purchase_8(7, 21)}

spriteset(spriteset_Tait_Roof1_Single_Purchase,   "gfx/Tait_Roof1.png") {template_purchase_8(187, 21)}
spriteset(spriteset_Tait_Roof2_Single_Purchase,   "gfx/Tait_Roof2.png") {template_purchase_8(187, 21)}

//MU
spriteset(spriteset_Tait_Panto_Purchase,   "gfx/Tait_Pantographs.png") {template_purchase_88mu(7, 21)}

spriteset(spriteset_Tait_PantoDown,   "gfx/Tait_Pantographs.png") {template_8(7, 39)}
spriteset(spriteset_Tait_PantoDown_r,   "gfx/Tait_Pantographs.png") {template_8_r(7, 39)}
spriteset(spriteset_Tait_PantoUp,   "gfx/Tait_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_Tait_PantoUp_r,   "gfx/Tait_Pantographs.png") {template_8_r(7, 69)}

spriteset(spriteset_Tait_Roof1_Purchase,   "gfx/Tait_Roof1.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Tait_Roof1_Motor,   "gfx/Tait_Roof1.png") {template_8(7, 39)}
spriteset(spriteset_Tait_Roof1_Motor_r,   "gfx/Tait_Roof1.png") {template_8_r(7, 39)}
spriteset(spriteset_Tait_Roof1_Trailer,   "gfx/Tait_Roof1.png") {template_8_repeat(7, 69)}


spriteset(spriteset_Tait_Roof2_Purchase,   "gfx/Tait_Roof2.png") {template_purchase_88mu(7, 21)}
spriteset(spriteset_Tait_Roof2_Motor,   "gfx/Tait_Roof2.png") {template_8(7, 39)}
spriteset(spriteset_Tait_Roof2_Motor_r,   "gfx/Tait_Roof2.png") {template_8_r(7, 39)}
spriteset(spriteset_Tait_Roof2_Trailer,   "gfx/Tait_Roof2.png") {template_8_repeat(7, 69)}

//Pantograph Controls
switch(FEAT_TRAINS, SELF, switch_Tait_Fw_railtype, tile_powers_railtype("BG_RAIL_OHLE_DC")) {
 0: spriteset_Tait_PantoDown;
 1: spriteset_Tait_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_Tait_Rw_railtype, tile_powers_railtype("BG_RAIL_OHLE_DC")) {
 0: spriteset_Tait_PantoDown_r; //might need switching back to just panto down
 1: spriteset_Tait_PantoUp_r;
}
//Roof Controls
//Purchase
switch(FEAT_TRAINS, PARENT, switch_Tait_Roof_Transition_Purchase, current_year) {
    0..1928: spriteset_Tait_Roof1_Purchase;
	1929..2100: spriteset_Tait_Roof2_Purchase;
  return spriteset_Tait_Roof2_Purchase;
}

//Motor Forward
random_switch(FEAT_TRAINS, SELF, switch_Tait_Roof_Transition_Motor_Random){
    3 : spriteset_Tait_Roof1_Motor;
	1 : spriteset_Tait_Roof2_Motor;
}

switch(FEAT_TRAINS, PARENT, switch_Tait_Roof_Transition_Motor, date_of_last_service) {
    0..date(1928, 12, 31): spriteset_Tait_Roof1_Motor;
	date(1929, 1, 1)..date(2100, 1, 1): switch_Tait_Roof_Transition_Motor_Random;
  return switch_Tait_Roof_Transition_Motor_Random;
}

//Motor Reversed
random_switch(FEAT_TRAINS, SELF, switch_Tait_Roof_Transition_Motor_r_Random){
    3 : spriteset_Tait_Roof1_Motor_r;
	1 : spriteset_Tait_Roof2_Motor_r;
}

switch(FEAT_TRAINS, PARENT, switch_Tait_Roof_Transition_Motor_r, date_of_last_service) {
    0..date(1928, 12, 31): spriteset_Tait_Roof1_Motor_r;
	date(1929, 1, 1)..date(2100, 1, 1): switch_Tait_Roof_Transition_Motor_r_Random;
  return switch_Tait_Roof_Transition_Motor_r_Random;
}

