    return sw_Hyundai_Mariyung_Liv0_pantocheck_at_2r;
}

switch(FEAT_TRAINS, SELF, sw_Hyundai_Mariyung_Liv0_lencheck, num_vehs_in_vehid_chain ) {
    0 .. 2 : spriteset_Hyundai_Mariyung_Liv0_Trailer;
    3 : sw_Hyundai_Mariyung_Liv0_pantocheck_at_1;
    4 : sw_Hyundai_Mariyung_Liv0_sidecheck_4;
    5 : sw_Hyundai_Mariyung_Liv0_pantocheck_at_2;
    6 .. 7 : sw_Hyundai_Mariyung_Liv0_sidecheck_6;
    return sw_Hyundai_Mariyung_Liv0_sidecheck_other;
}

