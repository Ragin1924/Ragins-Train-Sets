}

switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv0_panto_flipcheck, vehicle_is_flipped){
    0 : sw_Comeng_SSet_Liv0_panto_direction;        //Not flipped, give Panto
    return switch_Comeng_SSet_Liv0_Transition_Motor;    //Flipped, no panto
}

switch(FEAT_TRAINS, SELF, sw_Comeng_SSet_Liv0_frontcheck, position_in_vehid_chain){
    0: sw_Comeng_SSet_Liv0_panto_direction; //We need a pantograph, guaranteed
    return sw_Comeng_SSet_Liv0_panto_flipcheck; //More Checks
}

