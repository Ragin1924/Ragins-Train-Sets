const Comeng_XPTE_ID_Liv2 = (Comeng_XPTE_ID + Liv2_ID );

item(FEAT_TRAINS, Item_Comeng_XPTE_Liv2, Comeng_XPTE_ID_Liv2) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     [OHLE_DC, OHLE_AC];
		running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_ProposalDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];
		visual_effect_and_powered: 		VISUAL_EFFECT_ELECTRIC;

        name:                           string(STR_NAME_COMENG_XPTE);
		
		refit_cost:                     0;
        dual_headed:                    1;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Comeng_XPTE_IntroDate;		
		length:                         Comeng_XPTE_Length;
		
		loading_speed:					SD_Express_LoadingSpeed;
		speed:							Comeng_XPTE_Speed km/h;
		cost_factor:					(Comeng_XPTE_CostFactor * 2);
		running_cost_factor:			(Comeng_XPTE_RunningCostFactor * 2);
		cargo_capacity: 				0;
		power:							1 hp;
		weight:							Comeng_XPTE_Weight ton;

        variant_group: 					Item_Comeng_XPTE_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_Comeng_XPTE_Liv2_PowerCar;
        purchase: 						switch_Comeng_XPTE_Liv2_Purchase_Stack;
        additional_text: 				switch_Comeng_XPTE_buy_menu_additional_text;
		power:							switch_Comeng_XPTE_power_0;
    }
    livery_override (Item_MU_Trailer){
        default: 						switch_Comeng_XPT_Liv2_Trailer ;
        length: 						Comeng_XPTE_Length_T;
        cargo_capacity:                 (Comeng_XPTE_CargoCapacity / param_capacity_mod);
        power:                          0;
		weight:                        	Comeng_XPTE_Weight_T;
		running_cost_factor:            (Comeng_XPTE_RunningCostFactor / 2); //maybe remove the divide?

}
}

