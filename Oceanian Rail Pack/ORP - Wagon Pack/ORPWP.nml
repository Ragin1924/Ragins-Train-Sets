    return switch_BREL_Mk3_Liv1_dinerposition;
}

switch (FEAT_TRAINS, SELF, switch_BREL_Mk3_Liv1_SpriteStack2, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_BREL_Mk3_Liv1_Terminal_r;
    1: spriteset_8_Modern_EOTD_r;
}

switch(FEAT_TRAINS, SELF, switch_BREL_Mk3_Liv1_rearcheck2, position_in_consist_from_end){
    0 : switch_BREL_Mk3_Liv1_SpriteStack2;
    return switch_BREL_Mk3_Liv1_dinerposition;
}

switch(FEAT_TRAINS, SELF, switch_BREL_Mk3_Liv1_position, vehicle_is_flipped) {
 0: switch_BREL_Mk3_Liv1_rearcheck1;
 1: switch_BREL_Mk3_Liv1_rearcheck2;
}

const BREL_Mk3_Liv1_ID = (BREL_Mk3_ID + Liv1_ID);

item (FEAT_TRAINS, Item_BREL_Mk3_Liv1, BREL_Mk3_Liv1_ID) {
    property {
		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		track_type:                     RAIL;
		running_cost_base:              RUNNING_COST_STEAM;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_ProposalDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];    

        name:                           string(STR_NAME_BREL_MK3);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		
        introduction_date:              BREL_Mk3_IntroDate;		
		length:                         BREL_Mk3_Length;
		
		loading_speed:					SD_Intercity_LoadingSpeed;
		speed:							BREL_Mk3_Speed km/h;
		cost_factor:					BREL_Mk3_CostFactor;
		running_cost_factor:			BREL_Mk3_RunningCostFactor;
		cargo_capacity: 				(BREL_Mk3_CargoCapacity / param_capacity_mod);
		power:							0 hp;
		weight:							BREL_Mk3_Weight ton;

        variant_group: 					Item_BREL_Mk3_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
	}
    graphics {
    default:                            switch_BREL_Mk3_Liv1_position;
    purchase:                           spriteset_BREL_Mk3_Liv1_Purchase;
    additional_text: 					string(STR_INFO_BREL_MK3);
	cargo_capacity: 					(BREL_Mk3_CargoCapacity / param_capacity_mod);
}
}

