spriteset(spriteset_VLine_HType_Liv1,   "gfx/VLine_HType_Liv1.png") {template_8_repeat(7, 39)}
spriteset(spriteset_VLine_HType_Liv1_Terminal,   "gfx/VLine_HType_Liv1.png") {template_8(7, 69)}
spriteset(spriteset_VLine_HType_Liv1_Terminal_r,   "gfx/VLine_HType_Liv1.png") {template_8_r(7, 69)}

//Purchase Sprite
switch (FEAT_TRAINS, SELF, switch_VLine_HType_Liv1_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_VLine_HType_Liv1_Purchase;
	1: switch_Couplers_8_Repeat_Purchase;
}

//Normal Trailer
switch (FEAT_TRAINS, SELF, switch_VLine_HType_Liv1_NormalStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_VLine_HType_Liv1;
	1: switch_Couplers_8_Repeat;
}

//MTH Rear Switches
switch (FEAT_TRAINS, SELF, switch_VLine_HType_Liv1_MTHRearStack1, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_VLine_HType_Liv1;
	1: switch_Couplers_8_Repeat;
    2: spriteset_VLine_HType_EOTD;
}

switch(FEAT_TRAINS, SELF, switch_VLine_HType_Liv1_MTHrearcheck1, position_in_consist_from_end){
    0 : switch_VLine_HType_Liv1_MTHRearStack1;
    return switch_VLine_HType_Liv1_NormalStack;
}

switch (FEAT_TRAINS, SELF, switch_VLine_HType_Liv1_MTHRearStack2, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_VLine_HType_Liv1;
	1: switch_Couplers_8_Repeat;
    2: spriteset_VLine_HType_EOTD_r;
}

switch(FEAT_TRAINS, SELF, switch_VLine_HType_Liv1_MTHrearcheck2, position_in_consist_from_end){
    0 : switch_VLine_HType_Liv1_MTHRearStack2;
    return switch_VLine_HType_Liv1_NormalStack;
}

switch(FEAT_TRAINS, SELF, switch_VLine_HType_Liv1_MTHposition, vehicle_is_flipped) {
 0: switch_VLine_HType_Liv1_MTHrearcheck1;
 1: switch_VLine_HType_Liv1_MTHrearcheck2;
}

//Terminal Cars Switches
