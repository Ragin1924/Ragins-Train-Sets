const Tulloch_InterurbanCoach_Liv3_ID = (Tulloch_InterurbanCoach_ID + Liv3_ID);

item (FEAT_TRAINS, Item_Tulloch_InterurbanCoach_Liv3, Tulloch_InterurbanCoach_Liv3_ID) {
    property {
		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		track_type:                     RAIL;
		running_cost_base:              RUNNING_COST_STEAM;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             ALL_CLIMATES;
		refittable_cargo_classes:       CC_PASSENGERS;
		default_cargo_type:				PASS;
		cargo_allow_refit:              [PASS, TOUR];    

        name:                           string(STR_NAME_TULLOCH_INTERURBANCOACH);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		
        introduction_date:              Tulloch_InterurbanCoach_IntroDate;		
		length:                         8;
		
		loading_speed:					SD_Intercity_LoadingSpeed;
		speed:							Tulloch_InterurbanCoach_Speed km/h;
		cost_factor:					Tulloch_InterurbanCoach_CostFactor;
		running_cost_factor:			Tulloch_InterurbanCoach_RunningCostFactor;
		cargo_capacity: 				(Tulloch_InterurbanCoach_CargoCapacity / param_capacity_mod);
		power:							0 hp;
		weight:							Tulloch_InterurbanCoach_Weight ton;

        variant_group: 					Item_Tulloch_InterurbanCoach_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
	}
    graphics {
    default:                            switch_Tulloch_InterurbanCoach_Liv3_position;
    purchase:                           spriteset_Tulloch_InterurbanCoach_Liv3;
    additional_text: 					string(STR_INFO_TULLOCH_INTERURBANCOACH);
	cargo_capacity: 					(Tulloch_InterurbanCoach_CargoCapacity / param_capacity_mod);
}
}

