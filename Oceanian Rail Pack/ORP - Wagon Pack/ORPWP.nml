switch(FEAT_TRAINS, SELF, switch_VR_EType_Liv2_dinerposition, position_in_consist - position_in_consist_from_end) {
 0..1: spriteset_VR_EType_Liv2_Diner;
  spriteset_VR_EType_Liv2;
}

switch (FEAT_TRAINS, SELF, switch_VR_EType_Liv2_SpriteStack1, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_VR_EType_Liv2;
    1: spriteset_VR_EType_EOTD;
}

switch(FEAT_TRAINS, SELF, switch_VR_EType_Liv2_rearcheck1, position_in_consist_from_end){
    0 : switch_VR_EType_Liv2_SpriteStack1;
    return switch_VR_EType_Liv2_dinerposition;
}

