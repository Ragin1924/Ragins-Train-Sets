 0: switch_Mail_VR_EType_Liv3_rearcheck1;
 1: switch_Mail_VR_EType_Liv3_rearcheck2;
}

const Mail_VR_EType_Liv3_ID = (VR_EType_Liv3_ID + 50);

item (FEAT_TRAINS, Item_Mail_VR_EType_Liv3, Mail_VR_EType_Liv3_ID) {
    property {
		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		track_type:                     RAIL;
		running_cost_base:              RUNNING_COST_STEAM;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		refittable_cargo_classes:       bitmask (CC_MAIL, CC_EXPRESS);
		default_cargo_type:				MAIL;
//		cargo_allow_refit:              [];    

        name:                           string(STR_NAME_MAIL_VR_ETYPE);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		
        introduction_date:              VR_EType_IntroDate;		
		length:                         8;
		
		loading_speed:					SD_Intercity_LoadingSpeed;
		speed:							VR_EType_Speed km/h;
		cost_factor:					VR_EType_CostFactor;
		running_cost_factor:			VR_EType_RunningCostFactor;
		cargo_capacity: 				(VR_EType_CargoCapacity / param_capacity_mod);
		power:							0 hp;
		weight:							VR_EType_Weight ton;

        variant_group: 					Item_Mail_VR_EType_Liv0;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
	}
    graphics {
    default:                            switch_Mail_VR_EType_Liv3_position;
    purchase:                           spriteset_Mail_VR_EType_Liv3_Purchase;
    additional_text: 					string(STR_INFO_MAIL_VR_ETYPE);
	cargo_capacity: 					(VR_EType_CargoCapacity / param_capacity_mod);
}
}

