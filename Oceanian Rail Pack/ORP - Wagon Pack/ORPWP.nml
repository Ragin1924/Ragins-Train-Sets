		climates_available:             ALL_CLIMATES;
        refittable_cargo_classes:		bitmask(CC_COVERED_BULK, CC_POTABLE, CC_NON_POTABLE); //CoveredHopper
		non_refittable_cargo_classes:	bitmask(CC_PASSENGERS, CC_HAZARDOUS, CC_LIQUID); //CoveredHopper
		default_cargo_type:				GRAI; //CoveredHopper
		cargo_allow_refit:				[GRAI, WHEA, BEAN, SGCN, SGBT, OLSD, MAIZ, PEAT, SEED]; //CoveredHopper
		cargo_disallow_refit:			[TOUR, LVST, COAL, IORE, WOOL]; //CoveredHopper

        name:                           string(STR_NAME_GEN4A_COVEREDHOPPER_NG);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		
        introduction_date:              Gen4_IntroDate;		
		length:                         Gen4A_CoveredHopper_Length;
		
		loading_speed:					Gen4_LoadingSpeed;
		speed:							Gen4_Speed km/h;
		cost_factor:					Gen4_6_CostFactor;
		running_cost_factor:			Gen4_6_RunningCostFactor;
		cargo_capacity: 				(Gen4_6_CargoCapacity / param_freight_capacity_mod);
		weight:							Gen4A_CoveredHopper_Weight ton;

