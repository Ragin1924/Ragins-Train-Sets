		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		track_type:                     NG_RAIL_ONLY;
		running_cost_base:              RUNNING_COST_STEAM;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             ALL_CLIMATES;
		refittable_cargo_classes: 		bitmask(CC_FLATBED); //StakeBulkheadcar
		non_refittable_cargo_classes: 	bitmask(); //StakeBulkheadcar
		default_cargo_type:				GOOD; //StakeBulkheadcar
		cargo_allow_refit: 				[METL,PIPE,STEL,WDPR,WOOD]; //StakeBulkheadcar
		cargo_disallow_refit:			[TOUR, LVST]; //StakeBulkheadcar

        name:                           string(STR_NAME_GEN4A_STAKEBULKHEADCAR_NG);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
