//Early_4Wheel
spriteset(spriteset_Early_4Wheel_EOTD,   "gfx/Early_4Wheel_EOTD.png") {template_4(7, 39)}
spriteset(spriteset_Early_4Wheel_EOTD_r,   "gfx/Early_4Wheel_EOTD.png") {template_4_r(7, 39)}

//Early_4Wheel_Liv0
spriteset(spriteset_Early_4Wheel_Liv0_Purchase,   "gfx/Early_4Wheel_Liv0.png") {template_purchase_4(7, 21)}

spriteset(spriteset_Early_4Wheel_Liv0,   "gfx/Early_4Wheel_Liv0.png") {template_4_repeat(7, 39)}

//Purchase Sprite
switch (FEAT_TRAINS, SELF, switch_Early_4Wheel_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Early_4Wheel_Liv0_Purchase;
	1: switch_Couplers_4_Repeat_Purchase;
}

//Normal Trailer
switch (FEAT_TRAINS, SELF, switch_Early_4Wheel_Liv0_NormalStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Early_4Wheel_Liv0;
	1: switch_Couplers_4_Repeat;
}

//Terminal stacks
switch (FEAT_TRAINS, SELF, switch_Early_4Wheel_Liv0_SpriteStack1, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
