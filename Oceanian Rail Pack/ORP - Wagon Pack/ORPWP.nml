//ID
const NSW_KATramCar_ID = 5200;
//introduction_date
const NSW_KATramCar_IntroDate = date(1877, 1, 1);
//speed
const NSW_KATramCar_Speed = 60;
//cost_factor
const NSW_KATramCar_CostFactor = 27;
//running_cost_factor
const NSW_KATramCar_RunningCostFactor = 11;
//Cargo Capacity
const NSW_KATramCar_CargoCapacity = 53;
//weight
const NSW_KATramCar_Weight = 18;
//length
const NSW_KATramCar_Length = 6;

//NSW_KATramCar
spriteset(spriteset_NSW_KATramCar_EOTD,   "gfx/NSW_KATramCar_EOTD.png") {template_6(7, 39)}
spriteset(spriteset_NSW_KATramCar_EOTD_r,   "gfx/NSW_KATramCar_EOTD.png") {template_6_r(7, 39)}

//NSW_KATramCar_Liv0
spriteset(spriteset_NSW_KATramCar_Liv0_Purchase,   "gfx/NSW_KATramCar_Liv0.png") {template_purchase_6(7, 21)}

spriteset(spriteset_NSW_KATramCar_Liv0,   "gfx/NSW_KATramCar_Liv0.png") {template_6_repeat(7, 39)}
spriteset(spriteset_NSW_KATramCar_Liv0_Terminal,   "gfx/NSW_KATramCar_Liv0.png") {template_6(7, 69)}
spriteset(spriteset_NSW_KATramCar_Liv0_Terminal_r,   "gfx/NSW_KATramCar_Liv0.png") {template_6_r(7, 69)}

//Purchase Sprite
switch (FEAT_TRAINS, SELF, switch_NSW_KATramCar_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_NSW_KATramCar_Liv0_Purchase;
	1: switch_Couplers_6_Repeat_Purchase;
}

//Normal Trailer
switch (FEAT_TRAINS, SELF, switch_NSW_KATramCar_Liv0_NormalStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_NSW_KATramCar_Liv0;
	1: switch_Couplers_6_Repeat;
}

//Terminal stacks
switch (FEAT_TRAINS, SELF, switch_NSW_KATramCar_Liv0_SpriteStack1, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_NSW_KATramCar_Liv0_Terminal;
	1: switch_Couplers_6_Repeat;
    2: spriteset_NSW_KATramCar_EOTD;
}

switch(FEAT_TRAINS, SELF, switch_NSW_KATramCar_Liv0_rearcheck1, position_in_consist_from_end){
    0 : switch_NSW_KATramCar_Liv0_SpriteStack1;
    return switch_NSW_KATramCar_Liv0_NormalStack;
}

switch (FEAT_TRAINS, SELF, switch_NSW_KATramCar_Liv0_SpriteStack2, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_NSW_KATramCar_Liv0_Terminal_r;
	1: switch_Couplers_6_Repeat;
    2: spriteset_NSW_KATramCar_EOTD_r;
}

switch(FEAT_TRAINS, SELF, switch_NSW_KATramCar_Liv0_rearcheck2, position_in_consist_from_end){
    0 : switch_NSW_KATramCar_Liv0_SpriteStack2;
    return switch_NSW_KATramCar_Liv0_NormalStack;
}

switch(FEAT_TRAINS, SELF, switch_NSW_KATramCar_Liv0_position, vehicle_is_flipped) {
 0: switch_NSW_KATramCar_Liv0_rearcheck1;
 1: switch_NSW_KATramCar_Liv0_rearcheck2;
}

