        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		
        introduction_date:              Gen4_IntroDate;		
		length:                         Gen40_GoodsVan_Length;
		
		loading_speed:					Gen4_LoadingSpeed;
