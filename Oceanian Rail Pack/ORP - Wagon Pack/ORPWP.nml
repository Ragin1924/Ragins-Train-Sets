//Gen4A_Stakecar_Liv1
switch (FEAT_TRAINS, SELF, switch_Gen4A_Stakecar_Liv1_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen4A_Flatcar_Liv1_Purchase;
	1: spriteset_Gen4A_Flatcar_Stakes_Purchase;
    2: switch_Couplers_8_Repeat_Purchase;
}

