		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		track_type:                     BG_RAIL_ONLY;
		running_cost_base:              RUNNING_COST_STEAM;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             ALL_CLIMATES;
        refittable_cargo_classes:		bitmask( CC_MAIL, CC_POTABLE, CC_PIECE_GOODS, CC_COVERED_BULK, CC_POWDER_BULK, CC_LIQUID_BULK, CC_GAS_BULK, CC_EXPRESS, CC_ARMOURED ); //GoodsVan
		non_refittable_cargo_classes:	bitmask(CC_PASSENGERS); //GoodsVan
		default_cargo_type:				GOOD; //GoodsVan
//		cargo_allow_refit:				[GRAI, WHEA, BEAN, SGCN, SGBT, OLSD, MAIZ, PEAT, SEED]; //GoodsVan
		cargo_disallow_refit:			[TOUR, LVST]; //GoodsVan

        name:                           string(STR_NAME_GOODSVAN_HICUBE);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		
        introduction_date:              Gen6_IntroDate;		
		length:                         Gen6C_GoodsVan_Length;
		
		loading_speed:					Gen6_LoadingSpeed;
		speed:							Gen6_Speed km/h;
		cost_factor:					Gen6_8_CostFactor;
		running_cost_factor:			Gen6_8_RunningCostFactor;
		cargo_capacity: 				(Gen6_8_CargoCapacity / param_freight_capacity_mod);
		weight:							Gen6C_GoodsVan_Weight ton;

//        variant_group: 					Item_Gen6C_GoodsVan_Liv0_BG;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
	}
    graphics {
		default:                        switch_Gen6C_GoodsVan_Liv0_position;
		purchase:                       switch_Gen6C_GoodsVan_Liv0_PurchaseStack;
		additional_text: 				string(STR_INFO_BG);
		cargo_capacity: 				(Gen6_8_CargoCapacity / param_freight_capacity_mod);
}
}

//ID
const Gen6D_GoodsVan_ID = 32250;
//weight
const Gen6D_GoodsVan_Weight = 27;
//length
const Gen6D_GoodsVan_Length = 8;

//Gen6D_GoodsVan_Liv0
spriteset(spriteset_Gen6D_GoodsVan_Liv0_Purchase,   "gfx/Gen6D_GoodsVan_Liv0_0.png") {template_purchase_8(7, 21)}

spriteset(spriteset_Gen6D_GoodsVan_Liv0_0,   "gfx/Gen6D_GoodsVan_Liv0_0.png") {template_8_repeat(7, 39)}

switch (FEAT_TRAINS, SELF, switch_Gen6D_GoodsVan_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen6D_GoodsVan_Liv0_Purchase;
	1: switch_Couplers_8_Repeat_Purchase;
}

switch (FEAT_TRAINS, SELF, switch_Gen6D_GoodsVan_Liv0_NormalStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen6D_GoodsVan_Liv0_0;
	1: switch_Couplers_8_Repeat;
}

switch (FEAT_TRAINS, SELF, switch_Gen6D_GoodsVan_Liv0_SpriteStack1, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen6D_GoodsVan_Liv0_0;
	1: switch_Couplers_8_Repeat;
    2: switch_8_EOTD;
}

switch(FEAT_TRAINS, SELF, switch_Gen6D_GoodsVan_Liv0_rearcheck1, position_in_consist_from_end){
    0 : switch_Gen6D_GoodsVan_Liv0_SpriteStack1;
    return switch_Gen6D_GoodsVan_Liv0_NormalStack;
}

switch (FEAT_TRAINS, SELF, switch_Gen6D_GoodsVan_Liv0_SpriteStack2, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen6D_GoodsVan_Liv0_0;
	1: switch_Couplers_8_Repeat;
    2: switch_8_EOTD_r;
}

switch(FEAT_TRAINS, SELF, switch_Gen6D_GoodsVan_Liv0_rearcheck2, position_in_consist_from_end){
    0 : switch_Gen6D_GoodsVan_Liv0_SpriteStack2;
    return switch_Gen6D_GoodsVan_Liv0_NormalStack;
}

switch(FEAT_TRAINS, SELF, switch_Gen6D_GoodsVan_Liv0_position, vehicle_is_flipped) {
 0: switch_Gen6D_GoodsVan_Liv0_rearcheck1;
 1: switch_Gen6D_GoodsVan_Liv0_rearcheck2;
}

const Gen6D_GoodsVan_ID_Liv0_NG = (Gen6D_GoodsVan_ID + Liv0_ID);

item (FEAT_TRAINS, Item_Gen6D_GoodsVan_Liv0_NG, Gen6D_GoodsVan_ID_Liv0_NG) {
