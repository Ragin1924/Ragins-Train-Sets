	STST: random_Flatbed_8_metal;
	STSH: switch_Flatbed_8_slabs_recolour_load;
	STAL: random_Flatbed_8_metal;
	STCB: random_Flatbed_8_metal_ferrous;
	STWR: spritegroup_Flatbed_8_wires;
	STSE: random_Flatbed_8_metal_prod;
	NICK: random_Flatbed_8_metal;
	COBL: random_Flatbed_8_metal;
	
	ENSP: random_Flatbed_8_ensp;
	FMSP: random_Flatbed_8_fmsp;
	MNSP: random_Flatbed_8_tarp;
	POWR: random_Flatbed_8_tarp;
	VPTS: random_Flatbed_8_tarp;
	MPTS: random_Flatbed_8_tarp;
	GOOD: random_Flatbed_8_wdpr;
	
	BDMT: random_Flatbed_8_bdmt;
	GLAS: random_Flatbed_8_wdpr;
	BRCK: random_Flatbed_8_bdmt;
	PIPE: random_Flatbed_8_pipe;
	
	PAPR: random_Flatbed_8_tarp;
	TYRE: random_Flatbed_8_tarp;
	WOOL: random_Flatbed_8_tarp;
	TEXT: random_Flatbed_8_tarp;
	
	WOOD: spritegroup_Flatbed_8_logs;
	TWOD: spritegroup_Flatbed_8_logs;
