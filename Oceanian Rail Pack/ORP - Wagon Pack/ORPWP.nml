		cargo_disallow_refit:			[TOUR, LVST]; //OpenCar

        name:                           string(STR_NAME_GEN4A_OPENCAR_NG);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		
        introduction_date:              Gen4A_OpenCar_IntroDate;		
		length:                         8;
		
		loading_speed:					Gen4_LoadingSpeed;
