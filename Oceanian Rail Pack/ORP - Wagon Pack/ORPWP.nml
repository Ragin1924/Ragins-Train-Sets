spriteset(spriteset_Gen4A_Flatcar_Liv5_Purchase,   "gfx/Gen4A_Flatcar_Liv5_0.png") {template_purchase_8(7, 21)}
spriteset(spriteset_Gen4A_Flatcar_Liv5_0,   "gfx/Gen4A_Flatcar_Liv5_0.png") {template_8_repeat(7, 39)}

switch (FEAT_TRAINS, SELF, switch_Gen4A_Flatcar_Liv5_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen4A_Flatcar_Liv5_Purchase;
    1: switch_Couplers_8_Repeat_Purchase;
}

switch (FEAT_TRAINS, SELF, switch_Gen4A_Flatcar_Liv5_CargoStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen4A_Flatcar_Liv5_0;
	1: switch_Couplers_8_Repeat;
    2: switch_Flatbed_8_cargo_type;
}

