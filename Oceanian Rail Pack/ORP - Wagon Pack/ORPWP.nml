//ID
const Gen20_LivestockVan_ID = 34050;
//weight
const Gen20_LivestockVan_Weight = 10;
//length
const Gen20_LivestockVan_Length = 4;

//Gen20_LivestockVan_Liv0
spriteset(spriteset_Gen20_LivestockVan_Liv0_Purchase,   "gfx/Gen20_LivestockVan_Liv0_0.png") {template_purchase_4(7, 21)}

spriteset(spriteset_Gen20_LivestockVan_Liv0_0,   "gfx/Gen20_LivestockVan_Liv0_0.png") {template_4_repeat(7, 39)}

switch (FEAT_TRAINS, SELF, switch_Gen20_LivestockVan_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen20_LivestockVan_Liv0_Purchase;
	1: switch_Couplers_4_Repeat_Purchase;
}

switch (FEAT_TRAINS, SELF, switch_Gen20_LivestockVan_Liv0_NormalStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen20_LivestockVan_Liv0_0;
	1: switch_Couplers_4_Repeat;
}

switch (FEAT_TRAINS, SELF, switch_Gen20_LivestockVan_Liv0_SpriteStack1, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen20_LivestockVan_Liv0_0;
	1: switch_Couplers_4_Repeat;
    2: switch_4_EOTD;
}

switch(FEAT_TRAINS, SELF, switch_Gen20_LivestockVan_Liv0_rearcheck1, position_in_consist_from_end){
    0 : switch_Gen20_LivestockVan_Liv0_SpriteStack1;
    return switch_Gen20_LivestockVan_Liv0_NormalStack;
}

switch (FEAT_TRAINS, SELF, switch_Gen20_LivestockVan_Liv0_SpriteStack2, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen20_LivestockVan_Liv0_0;
	1: switch_Couplers_4_Repeat;
    2: switch_4_EOTD_r;
}

switch(FEAT_TRAINS, SELF, switch_Gen20_LivestockVan_Liv0_rearcheck2, position_in_consist_from_end){
    0 : switch_Gen20_LivestockVan_Liv0_SpriteStack2;
    return switch_Gen20_LivestockVan_Liv0_NormalStack;
}

