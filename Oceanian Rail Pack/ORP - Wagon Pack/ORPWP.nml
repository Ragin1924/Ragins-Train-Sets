//ID
const NSW_Ashbury_ID = 8400;
//introduction_date
const NSW_Ashbury_IntroDate = date(1879, 1, 1);
//speed
const NSW_Ashbury_Speed = 80;
//cost_factor
const NSW_Ashbury_CostFactor = 38;
//running_cost_factor
const NSW_Ashbury_RunningCostFactor = 16;
//Cargo Capacity
const NSW_Ashbury_CargoCapacity = 50;
//weight
const NSW_Ashbury_Weight = 34;
//length
const NSW_Ashbury_Length = 7;

//NSW_Ashbury
spriteset(spriteset_NSW_Ashbury_EOTD,   "gfx/NSW_Ashbury_EOTD.png") {template_7(7, 39)}
spriteset(spriteset_NSW_Ashbury_EOTD_r,   "gfx/NSW_Ashbury_EOTD.png") {template_7_r(7, 39)}

//NSW_Ashbury_Liv0
spriteset(spriteset_NSW_Ashbury_Liv0_Purchase,   "gfx/NSW_Ashbury_Liv0.png") {template_purchase_7(7, 21)}

spriteset(spriteset_NSW_Ashbury_Liv0,   "gfx/NSW_Ashbury_Liv0.png") {template_7_repeat(7, 39)}
spriteset(spriteset_NSW_Ashbury_Liv0_Terminal,   "gfx/NSW_Ashbury_Liv0.png") {template_7(7, 69)}
spriteset(spriteset_NSW_Ashbury_Liv0_Terminal_r,   "gfx/NSW_Ashbury_Liv0.png") {template_7_r(7, 69)}

//Purchase Sprite
switch (FEAT_TRAINS, SELF, switch_NSW_Ashbury_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_NSW_Ashbury_Liv0_Purchase;
	1: switch_Couplers_7_Repeat_Purchase;
}

//Normal Trailer
switch (FEAT_TRAINS, SELF, switch_NSW_Ashbury_Liv0_NormalStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_NSW_Ashbury_Liv0;
	1: switch_Couplers_7_Repeat;
}

//Terminal stacks
switch (FEAT_TRAINS, SELF, switch_NSW_Ashbury_Liv0_SpriteStack1, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_NSW_Ashbury_Liv0_Terminal;
	1: switch_Couplers_7_Repeat;
    2: spriteset_NSW_Ashbury_EOTD;
}

switch(FEAT_TRAINS, SELF, switch_NSW_Ashbury_Liv0_rearcheck1, position_in_consist_from_end){
    0 : switch_NSW_Ashbury_Liv0_SpriteStack1;
    return switch_NSW_Ashbury_Liv0_NormalStack;
}

switch (FEAT_TRAINS, SELF, switch_NSW_Ashbury_Liv0_SpriteStack2, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_NSW_Ashbury_Liv0_Terminal_r;
	1: switch_Couplers_7_Repeat;
    2: spriteset_NSW_Ashbury_EOTD_r;
}

switch(FEAT_TRAINS, SELF, switch_NSW_Ashbury_Liv0_rearcheck2, position_in_consist_from_end){
    0 : switch_NSW_Ashbury_Liv0_SpriteStack2;
    return switch_NSW_Ashbury_Liv0_NormalStack;
}

switch(FEAT_TRAINS, SELF, switch_NSW_Ashbury_Liv0_position, vehicle_is_flipped) {
 0: switch_NSW_Ashbury_Liv0_rearcheck1;
 1: switch_NSW_Ashbury_Liv0_rearcheck2;
}

