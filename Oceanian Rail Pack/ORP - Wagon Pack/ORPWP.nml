//ID
const Gen3B_OpenHopper_ID = 43550;
//weight
const Gen3B_OpenHopper_Weight = 18;
//length
const Gen3B_OpenHopper_Length = 5;

//Hoppers
spriteset(spriteset_Gen3B_OpenHopper_Loadh,   "gfx/Gen3B_OpenHopper_Load.png") {template_5_repeat(7, 39)}
spriteset(spriteset_Gen3B_OpenHopper_Loadf,   "gfx/Gen3B_OpenHopper_Load.png") {template_5_repeat(7, 69)}

switch(FEAT_TRAINS, SELF, switch_Gen3B_OpenHopper_loadcheck, cargo_count * (100 / cargo_capacity)){
	1..50	: spriteset_Gen3B_OpenHopper_Loadh ;
	51..100	: spriteset_Gen3B_OpenHopper_Loadf ;
}

switch (FEAT_TRAINS, SELF, switch_Gen3B_OpenHopper_recolour_load, STORE_TEMP(switch_generic_recolour(), 0x100)) {
    return switch_Gen3B_OpenHopper_loadcheck;
}

//Gen3B_OpenHopper_Liv0
spriteset(spriteset_Gen3B_OpenHopper_Liv0_Purchase,   "gfx/Gen3B_OpenHopper_Liv0_0.png") {template_purchase_5(7, 21)}

spriteset(spriteset_Gen3B_OpenHopper_Liv0_0,   "gfx/Gen3B_OpenHopper_Liv0_0.png") {template_5_repeat(7, 39)}

//Purchase Sprite Stacker
switch (FEAT_TRAINS, SELF, switch_Gen3B_OpenHopper_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen3B_OpenHopper_Liv0_Purchase;
    1: switch_Couplers_5_Repeat_Purchase;
}

switch (FEAT_TRAINS, SELF, switch_Gen3B_OpenHopper_Liv0_CargoStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen3B_OpenHopper_Liv0_0;
	1: switch_Couplers_5_Repeat;
    2: switch_Gen3B_OpenHopper_recolour_load;
}

switch (FEAT_TRAINS, SELF, switch_Gen3B_OpenHopper_Liv0_RearStack1, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen3B_OpenHopper_Liv0_0;
	1: switch_Couplers_5_Repeat;
	2: switch_5_EOTD;
    3: switch_Gen3B_OpenHopper_recolour_load;
}

switch(FEAT_TRAINS, SELF, switch_Gen3B_OpenHopper_Liv0_rearcheck1, position_in_consist_from_end){
    0 : switch_Gen3B_OpenHopper_Liv0_RearStack1;
    return switch_Gen3B_OpenHopper_Liv0_CargoStack;
}

switch (FEAT_TRAINS, SELF, switch_Gen3B_OpenHopper_Liv0_RearStack2, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen3B_OpenHopper_Liv0_0;
	1: switch_Couplers_5_Repeat;
	2: switch_5_EOTD_r;
    3: switch_Gen3B_OpenHopper_recolour_load;
}

switch(FEAT_TRAINS, SELF, switch_Gen3B_OpenHopper_Liv0_rearcheck2, position_in_consist_from_end){
    0 : switch_Gen3B_OpenHopper_Liv0_RearStack2;
