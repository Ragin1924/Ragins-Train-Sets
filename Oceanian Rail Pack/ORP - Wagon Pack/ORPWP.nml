//Gen5B_GoodsVan_Liv0
spriteset(spriteset_Gen5B_GoodsVan_Liv0_Purchase,   "gfx/Gen5B_GoodsVan_Liv0_0.png") {template_purchase_9(7, 21)}

spriteset(spriteset_Gen5B_GoodsVan_Liv0_0,   "gfx/Gen5B_GoodsVan_Liv0_0.png") {template_9_repeat(7, 39)}

switch (FEAT_TRAINS, SELF, switch_Gen5B_GoodsVan_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen5B_GoodsVan_Liv0_Purchase;
    1: switch_Couplers_9_Repeat_Purchase;
}

switch (FEAT_TRAINS, SELF, switch_Gen5B_GoodsVan_Liv0_SpriteStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen5B_GoodsVan_Liv0_0;
    1: switch_Couplers_9_Repeat;
}

switch (FEAT_TRAINS, SELF, switch_Gen5B_GoodsVan_Liv0_RearStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen5B_GoodsVan_Liv0_0;
    1: switch_Couplers_9_Repeat;
	2: switch_9_EOTD;
}

switch(FEAT_TRAINS, SELF, switch_Gen5B_GoodsVan_Liv0_rearcheck, position_in_consist_from_end){
    0 : switch_Gen5B_GoodsVan_Liv0_SpriteStack;
	1 : switch_Gen5B_GoodsVan_Liv0_RearStack;
    return switch_Gen5B_GoodsVan_Liv0_SpriteStack;
}

switch(FEAT_TRAINS, SELF, switch_Gen5B_GoodsVan_Liv0_position, position_in_articulated_veh) {
 0: switch_Gen5B_GoodsVan_Liv0_rearcheck;
 1: spriteset_8_Blank;
}

switch(FEAT_TRAINS, SELF, switch_Gen5B_GoodsVan_Liv0_length, position_in_vehid_chain % 2) {
 0: 5;
 1: 4;
 }

