const Gen4A_Flatcar_ID_Liv2_NG = (Gen4A_Flatcar_ID + Liv2_ID);

item (FEAT_TRAINS, Item_Gen4A_Flatcar_Liv2_NG, Gen4A_Flatcar_ID_Liv2_NG) {
    property {
		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		track_type:                     NG_RAIL_ONLY;
		running_cost_base:              RUNNING_COST_STEAM;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             ALL_CLIMATES;
		refittable_cargo_classes: 		bitmask(CC_FLATBED); //Flatcar
		non_refittable_cargo_classes: 	bitmask(); //Flatcar
		default_cargo_type:				GOOD; //Flatcar
		cargo_allow_refit: 				[METL,PIPE,STEL,WDPR,WOOD]; //Flatcar
		cargo_disallow_refit:			[TOUR, LVST]; //Flatcar

        name:                           string(STR_NAME_GEN4A_FLATCAR_NG);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		
        introduction_date:              Gen4A_Flatcar_IntroDate;		
		length:                         8;
		
		loading_speed:					Gen4_LoadingSpeed;
		speed:							Gen4_Speed km/h;
		cost_factor:					Gen4_8_CostFactor;
		running_cost_factor:			Gen4_8_RunningCostFactor;
		cargo_capacity: 				(Gen4_8_CargoCapacity / param_freight_capacity_mod);
		weight:							Gen4A_Flatcar_Weight ton;

        variant_group: 					Item_Gen4A_Flatcar_Liv0_NG;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
	}
    graphics {
    default:                             switch_Gen4A_Flatcar_Liv2_position;
    purchase:                            switch_Gen4A_Flatcar_Liv2_PurchaseStack;
    additional_text: 					 string(STR_INFO_GEN4A_FLATCAR_NG);
}
}

