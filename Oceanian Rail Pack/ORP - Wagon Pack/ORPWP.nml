		length:                         Goninan_Tangara_Coach_Length;
		
		loading_speed:					SD_Suburban_LoadingSpeed;
		speed:							Goninan_Tangara_Coach_Speed km/h;
		cost_factor:					Goninan_Tangara_Coach_CostFactor;
		running_cost_factor:			Goninan_Tangara_Coach_RunningCostFactor;
		cargo_capacity: 				(Goninan_Tangara_Coach_CargoCapacity / param_capacity_mod);
