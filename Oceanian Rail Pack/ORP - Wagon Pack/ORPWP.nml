//random cargos

random_switch (FEAT_TRAINS, SELF, random_Flatbed_8_tarp) {
	1: spritegroup_Flatbed_8_tarp_a;
	1: spritegroup_Flatbed_8_tarp_b;
	1: spritegroup_Flatbed_8_tarp_c;
}


random_switch (FEAT_TRAINS, SELF, random_Flatbed_8_metal) {
	3: switch_Flatbed_8_coils_recolour_load;
	1: switch_Flatbed_8_rods_recolour_load;
	1: switch_Flatbed_8_slabs_recolour_load;
}

random_switch (FEAT_TRAINS, SELF, random_Flatbed_8_metal_ferrous) {
	3: switch_Flatbed_8_coils_recolour_load;
	1: switch_Flatbed_8_rods_recolour_load;
	1: switch_Flatbed_8_slabs_recolour_load;
	1: spritegroup_Flatbed_8_pipes_alt;
}

random_switch (FEAT_TRAINS, SELF, random_Flatbed_8_metal_prod) {
	3: switch_Flatbed_8_rods_recolour_load;
	1: switch_Flatbed_8_pipes_recolour_load; 
	2: switch_Flatbed_8_slabs_recolour_load;
	1: spritegroup_Flatbed_8_pipes_alt;
}

random_switch (FEAT_TRAINS, SELF, random_Flatbed_8_bdmt) {
	3: switch_Flatbed_8_beams_recolour_load;
	1: switch_Flatbed_8_pipes_recolour_load;
	1: switch_Flatbed_8_slabs_recolour_load;
	2: random_Flatbed_8_tarp;
	1: spritegroup_Flatbed_8_pipes_alt;
}

random_switch (FEAT_TRAINS, SELF, random_Flatbed_8_pipe) {
	1: switch_Flatbed_8_pipes_recolour_load;
	1: spritegroup_Flatbed_8_pipes_alt;
}


random_switch (FEAT_TRAINS, SELF, random_Flatbed_8_wdpr) {
	3: switch_Flatbed_8_rods_recolour_load;
	1: switch_Flatbed_8_beams_recolour_load;
	1: switch_Flatbed_8_slabs_recolour_load;
	2: random_Flatbed_8_tarp;
}

random_switch (FEAT_TRAINS, SELF, random_Flatbed_8_ensp) {
	2: spritegroup_Flatbed_8_ensp;
	1: spritegroup_Flatbed_8_ensp;
	2: random_Flatbed_8_tarp;
}

random_switch (FEAT_TRAINS, SELF, random_Flatbed_8_fmsp) {
	2: spritegroup_Flatbed_8_fmsp;
	1: spritegroup_Flatbed_8_fmsp;
	2: random_Flatbed_8_tarp;
}

random_switch (FEAT_TRAINS, SELF, random_Flatbed_8_cars) {
	1: spritegroup_Flatbed_8_cars_a;
	1: spritegroup_Flatbed_8_cars_b;
	1: spritegroup_Flatbed_8_cars_c;
	1: spritegroup_Flatbed_8_cars_d;
}

