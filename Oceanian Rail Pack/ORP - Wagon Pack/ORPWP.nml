 0: switch_VLine_HType_Liv1_rearcheck1;
 1: switch_VLine_HType_Liv1_rearcheck2;
}

//MTH Checks
switch(FEAT_TRAINS, SELF, switch_HType_Liv1_MTHrearcheck, position_in_consist_from_end){
    0 : switch_VLine_HType_Liv1_MTHposition;
