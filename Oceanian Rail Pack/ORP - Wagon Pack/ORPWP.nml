    property {
		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		track_type:                     BG_RAIL_ONLY;
		running_cost_base:              RUNNING_COST_STEAM;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             ALL_CLIMATES;
//        refittable_cargo_classes:		bitmask( ); //LivestockVan
		non_refittable_cargo_classes:	bitmask(CC_PASSENGERS); //LivestockVan
		default_cargo_type:				LVST; //LivestockVan
		cargo_allow_refit:				[LVST]; //LivestockVan
//		cargo_disallow_refit:			[ ]; //LivestockVan

        name:                           string(STR_NAME_LIVESTOCKVAN);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		
        introduction_date:              Gen3_IntroDate;		
		length:                         Gen30_LivestockVan_Length;
		
		loading_speed:					Gen3_LoadingSpeed;
		speed:							Gen3_Speed km/h;
		cost_factor:					Gen3_4_CostFactor;
		running_cost_factor:			Gen3_4_RunningCostFactor;
		cargo_capacity: 				(Gen3_4_CargoCapacity / param_freight_capacity_mod);
		weight:							Gen30_LivestockVan_Weight ton;

//        variant_group: 					Item_Gen30_LivestockVan_Liv0_BG;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
	}
    graphics {
		default:                        switch_Gen30_LivestockVan_Liv0_position;
		purchase:                       switch_Gen30_LivestockVan_Liv0_PurchaseStack;
		additional_text: 				string(STR_INFO_BG);
		cargo_capacity: 				(Gen3_4_CargoCapacity / param_freight_capacity_mod);
}
}

//ID
const Gen40_LivestockVan_ID = 34150;
//weight
const Gen40_LivestockVan_Weight = 12;
//length
const Gen40_LivestockVan_Length = 4;

//Gen40_LivestockVan_Liv0
spriteset(spriteset_Gen40_LivestockVan_Liv0_Purchase,   "gfx/Gen40_LivestockVan_Liv0_0.png") {template_purchase_4(7, 21)}

spriteset(spriteset_Gen40_LivestockVan_Liv0_0,   "gfx/Gen40_LivestockVan_Liv0_0.png") {template_4_repeat(7, 39)}

switch (FEAT_TRAINS, SELF, switch_Gen40_LivestockVan_Liv0_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen40_LivestockVan_Liv0_Purchase;
	1: switch_Couplers_4_Repeat_Purchase;
}

switch (FEAT_TRAINS, SELF, switch_Gen40_LivestockVan_Liv0_NormalStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen40_LivestockVan_Liv0_0;
	1: switch_Couplers_4_Repeat;
}

switch (FEAT_TRAINS, SELF, switch_Gen40_LivestockVan_Liv0_SpriteStack1, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen40_LivestockVan_Liv0_0;
	1: switch_Couplers_4_Repeat;
    2: switch_4_EOTD;
}

switch(FEAT_TRAINS, SELF, switch_Gen40_LivestockVan_Liv0_rearcheck1, position_in_consist_from_end){
    0 : switch_Gen40_LivestockVan_Liv0_SpriteStack1;
    return switch_Gen40_LivestockVan_Liv0_NormalStack;
}

switch (FEAT_TRAINS, SELF, switch_Gen40_LivestockVan_Liv0_SpriteStack2, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen40_LivestockVan_Liv0_0;
	1: switch_Couplers_4_Repeat;
    2: switch_4_EOTD_r;
}

switch(FEAT_TRAINS, SELF, switch_Gen40_LivestockVan_Liv0_rearcheck2, position_in_consist_from_end){
    0 : switch_Gen40_LivestockVan_Liv0_SpriteStack2;
    return switch_Gen40_LivestockVan_Liv0_NormalStack;
}

switch(FEAT_TRAINS, SELF, switch_Gen40_LivestockVan_Liv0_position, vehicle_is_flipped) {
 0: switch_Gen40_LivestockVan_Liv0_rearcheck1;
 1: switch_Gen40_LivestockVan_Liv0_rearcheck2;
}

