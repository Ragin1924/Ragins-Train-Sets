//Gen4A_Bulkheadcar_Liv4
switch (FEAT_TRAINS, SELF, switch_Gen4A_Bulkheadcar_Liv4_PurchaseStack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Gen4A_Flatcar_Liv4_Purchase;
	1: spriteset_Gen4A_Flatcar_Liv4_0_Bulkheads_Purchase;
    2: switch_Couplers_8_Repeat_Purchase;
