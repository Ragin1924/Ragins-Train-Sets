const Gen5H_OpenHopper_ID_Liv4_NG = (Gen5H_OpenHopper_ID + Liv4_ID);

item (FEAT_TRAINS, Item_Gen5H_OpenHopper_Liv4_NG, Gen5H_OpenHopper_ID_Liv4_NG) {
    property {
		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK, TRAIN_FLAG_AUTOREFIT);
		track_type:                     NG_RAIL_ONLY;
		running_cost_base:              RUNNING_COST_STEAM;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             ALL_CLIMATES;
		refittable_cargo_classes:		bitmask(CC_BULK); //OpenHopper
		non_refittable_cargo_classes:	bitmask(CC_PASSENGERS, CC_COVERED_BULK, CC_POTABLE, CC_HAZARDOUS); //OpenHopper
		default_cargo_type:				COAL; //OpenHopper
//		cargo_allow_refit:				[GRAI, WHEA, BEAN, SGCN, SGBT, OLSD, MAIZ, PEAT, SEED]; //OpenHopper
		cargo_disallow_refit:			[TOUR, LVST, MAIZ, GRAI, WHEA, CERE, BEAN, CASS, SGBT, CTCD, TOFF]; //OpenHopper

        name:                           string(STR_NAME_GEN5H_OPENHOPPER_NG);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		
        introduction_date:              Gen5_IntroDate;		
		length:                         Gen5H_OpenHopper_Length;
		
		loading_speed:					Gen5_LoadingSpeed;
		speed:							Gen5_Speed km/h;
		cost_factor:					Gen5_7_CostFactor;
		running_cost_factor:			Gen5_7_RunningCostFactor;
		cargo_capacity: 				(Gen5_7_CargoCapacity / param_freight_capacity_mod);
		weight:							Gen5H_OpenHopper_Weight ton;

        variant_group: 					Item_Gen5H_OpenHopper_Liv0_NG;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
	}
    graphics {
		default:                        switch_Gen5H_OpenHopper_Liv4_position;
		purchase:                       switch_Gen5H_OpenHopper_Liv4_PurchaseStack;
		additional_text: 				string(STR_INFO_GEN5H_OPENHOPPER_NG);
		cargo_capacity: 				(Gen5_7_CargoCapacity / param_freight_capacity_mod);
}
}

