        switch (FEAT_TRAINS, SELF, switch_MetroVick_46Class_3R_Liv0_power_0, tile_powers_railtype("SAA3")) {
            1: return 3400;
                return switch_MetroVick_46Class_3R_Liv0_power_1;
        }

